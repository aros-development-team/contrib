diff -ruN tar-1.35/src/misc.c tar-1.35.aros/src/misc.c
--- tar-1.35/src/misc.c	2023-07-17 15:07:12.000000000 +0100
+++ tar-1.35.aros/src/misc.c	2026-07-27 14:25:47.816517896 +0100
@@ -1195,7 +1195,12 @@
 pid_t
 xfork (void)
 {
+#ifdef __AROS__
+  /* AROS has no fork(); posixc.library provides vfork()+exec. */
+  pid_t p = vfork ();
+#else
   pid_t p = fork ();
+#endif
   if (p == (pid_t) -1)
     call_arg_fatal ("fork", _("child process"));
   return p;
