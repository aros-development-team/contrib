include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-gnu : contrib-gnu-bc
#MM- contrib-gnu-bc : development-bc

NOWARN_FLAGS := $(NOWARN_UNUSED_BUT_SET_VARIABLE) \
        $(NOWARN_IMPLICIT_FUNCTION_DECL) $(NOWARN_IMPLICIT_INT) \
        $(NOWARN_BUILTIN_DECLARATION_MISMATCH)
USER_CFLAGS := $(CFLAGS_GNU99) $(NOWARN_FLAGS) -fcommon

%fetch_and_build_gnu_development package=bc version=1.08.2 suffixes="tar.gz" extraoptions="--disable-year2038"

development-bc--make-env += MAKEINFO=true
