diff -ruN sed-4.10/gnulib-tests/fpurge.c sed-4.10.aros/gnulib-tests/fpurge.c
--- sed-4.10/gnulib-tests/fpurge.c	2026-01-03 01:28:00.000000000 +0000
+++ sed-4.10.aros/gnulib-tests/fpurge.c	2026-07-27 14:08:06.693435576 +0100
@@ -142,6 +142,10 @@
 # elif defined EPLAN9               /* Plan9 */
   fp->rp = fp->wp = fp->lp = fp->buf;
   return 0;
+# elif defined __AROS__
+  /* AROS FILE is opaque; nothing to purge at this level. */
+  (void) fp;
+  return 0;
 # else
 #  error "Please port gnulib fpurge.c to your platform! Look at the definitions of fflush, setvbuf and ungetc on your system, then report this to bug-gnulib."
 # endif
diff -ruN sed-4.10/gnulib-tests/freading.c sed-4.10.aros/gnulib-tests/freading.c
--- sed-4.10/gnulib-tests/freading.c	2026-01-03 01:28:00.000000000 +0000
+++ sed-4.10.aros/gnulib-tests/freading.c	2026-07-27 14:08:06.693482676 +0100
@@ -72,6 +72,10 @@
   if (fp->state == 0 /* CLOSED */ || fp->state == 4 /* WR */)
     return 0;
   return (fp->state == 3 /* RD */ && (fp->bufl == 0 || fp->rp < fp->wp));
+# elif defined __AROS__
+  /* AROS FILE is opaque; assume not reading. */
+  (void) fp;
+  return 0;
 # else
 #  error "Please port gnulib freading.c to your platform!"
 # endif
