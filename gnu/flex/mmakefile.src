include $(SRCDIR)/config/aros-contrib.cfg

FLEX_VERSBASE = 2.6.4
FLEX_VERSION = $(FLEX_VERSBASE)
ARCHBASE := flex-$(FLEX_VERSBASE)

#MM- contrib-gnu : contrib-gnu-flex
#MM- contrib-gnu-flex : development-flex

REPOSITORIES := \
 https://github.com/westes/flex/releases/download/v$(FLEX_VERSION) \
 https://downloads.yoctoproject.org/mirror/sources \
 http://ftp.netbsd.org/pub/pkgsrc/distfiles

NOWARN_FLAGS := $(NOWARN_IMPLICIT_FUNCTION_DECL)
USER_CFLAGS := $(CFLAGS_GNU99) $(NOWARN_FLAGS)

%fetch_and_build_gnu_development package=flex version=$(FLEX_VERSION) srcdir=$(ARCHBASE) patch=yes extraoptions="--disable-year2038" \
    package_repo=$(REPOSITORIES) suffixes="tar.gz" usecppflags=no \
    config_env_extra="ac_cv_func_malloc_0_nonnull=yes ac_cv_func_realloc_0_nonnull=yes"
