+      esac
+    fi
+
+    test "$gl_msg" != '' && { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: $gl_msg" >&5
+printf "%s\n" "$as_me: WARNING: $gl_msg" >&2;}
+  done
+
+  for gl_i in $gl_do_install_prog; do
+    case " $gl_no_install_progs_default " in
+      *" $gl_i "*) {
