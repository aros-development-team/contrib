+#ifdef __AROS__
+/* AROS has no poll(); probe each descriptor with fcntl() instead. */
+static int
+visit_open_fds (int fd_min, int fd_max,
+                int (*callback)(int, void*), void *cb_context)
+{
+  int fd, rv;
+
+  for (fd = fd_min; fd < fd_max; fd++)
+    {
+      if (fcntl (fd, F_GETFD) != -1)
+        {
+          if (0 != (rv = callback (fd, cb_context)))
+            return rv;
+        }
+    }
+  return 0;
+}
