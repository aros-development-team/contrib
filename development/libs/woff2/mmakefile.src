include $(SRCDIR)/config/aros-contrib.cfg

WOFF2_VERSION := 1.0.2
ARCHBASE := v$(WOFF2_VERSION)
REPOSITORIES := https://github.com/google/woff2/archive/refs/tags
# The github tag tarball unpacks to woff2-<version>, not <tag>
WOFF2_SRCSUBDIR := woff2-$(WOFF2_VERSION)

# Static woff2common/woff2dec/woff2enc plus pkg-config files, for WebKit's
# WOFF2 web font support. Upstream asks for CMake 2.8.6, which CMake 4 refuses.
# libbrotlidec.pc lists brotlicommon only as a private dependency, which the
# upstream find module ignores, so the tools are linked against it explicitly.
WOFF2_OPTIONS := \
    -DCMAKE_VERBOSE_MAKEFILE:BOOL=OFF \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_PREFIX_PATH=$(AROS_DEVELOPER) \
    -DCMAKE_CXX_STANDARD_LIBRARIES=$(AROS_DEVELOPER)/lib/libbrotlicommon.a

#MM- contrib-development : contrib-woff2
#MM- contrib-woff2 : development-woff2

#MM development-woff2 : includes-copy linklibs contrib-brotli development-woff2-fetch

%fetch mmake=development-woff2-fetch archive=$(ARCHBASE) destination=$(PORTSDIR)/woff2 \
       location=$(PORTSSOURCEDIR)/woff2 archive_origins=$(REPOSITORIES) suffixes="tar.gz"

%create_patch mmake=development-woff2-create-patch \
       archive=$(ARCHBASE) srcdir=$(WOFF2_SRCSUBDIR) destination=$(PORTSDIR)/woff2

%build_with_cmake mmake=development-woff2 \
       srcdir="$(PORTSDIR)/woff2/$(WOFF2_SRCSUBDIR)" prefix="$(AROS_DEVELOPER)" \
       extraoptions="$(WOFF2_OPTIONS)"

%common
