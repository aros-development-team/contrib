include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-development : development-libxml2
#MM- development-libxml2 : development-libiconv

XML2_VERS := 2.15
XML2_VERSFULL := $(XML2_VERS).3

REPOSITORIES := https://download.gnome.org/sources/libxml2/$(XML2_VERS) \
 http://bbgentoo.ilb.ru/distfiles \
 https://ftp.osuosl.org/pub/blfs/conglomeration/libxml2 \
 https://download.videolan.org/contrib/libxml2

XML2_OPTIONS = \
    --disable-shared \
    --with-modules=no \
    --with-iconv=no \
    --with-debug=no \
    --with-threads=no \
    --with-python=no \
    --libdir=$(AROS_LIB) \
    --includedir=$(AROS_INCLUDES)

XML2_CFLAGS=-DPOSIXC_NO_VAARGS
ifneq (x86_64,$(AROS_TARGET_CPU))
XML2_CFLAGS+=$(OPTIMIZATION_CFLAGS)
endif

#MM
libxml2-post:
	$(Q)$(IF) ! $(TEST) -f $(TOOLDIR)/$(CPU)-aros-xml2-config || grep -q "$(AROS_DEVELOPER)" $(AROS_DEV_BINS)/xml2-config; then \
		$(CP) $(AROS_DEV_BINS)/xml2-config $(TOOLDIR)/$(CPU)-aros-xml2-config \
        && $(SED) -i -e "s|$(AROS_DEVELOPER)|\$${prefix}|g" $(AROS_DEV_BINS)/xml2-config ; \
	fi

%fetch_and_build_gnu_development package=libxml2 version=$(XML2_VERSFULL) patch=no \
    package_repo=$(REPOSITORIES) suffixes="tar.xz tar.gz" postinstall=libxml2-post \
    extracflags="$(XML2_CFLAGS)" extraoptions="$(XML2_OPTIONS)" nlsflag=no xflag=no
