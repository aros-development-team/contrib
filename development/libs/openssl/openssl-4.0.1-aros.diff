+ * AROS has no alarm() or interval timers; benchmark for the requested
+ * duration by polling a wall-clock deadline from the COND() macro.
+ */
+static time_t aros_alarm_deadline;
+static unsigned int aros_alarm(unsigned int secs)
+{
+    aros_alarm_deadline = (secs != 0) ? time(NULL) + (time_t)secs : 0;
+    return 0;
+}
+#define alarm aros_alarm
+
+static int aros_alarm_check(void)
+{
+    if (aros_alarm_deadline != 0 && time(NULL) >= aros_alarm_deadline)
+        run = 0;
+    return run;
+}
+#define AROS_COND_POLL(count) (((count) & 0xfff) != 0xfff || aros_alarm_check())
+
+static double Time_F(int s)
+{
+    double ret = app_tminterval(s, usertime);
+    if (s == STOP)
