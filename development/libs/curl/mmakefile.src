include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-curl : development-curl
#MM- development-curl : contrib-openssl linklibs-pthread workbench-libs-zstd-library-linklib
#MM development-curl-fixconfig : development-curl-pakagefiles

REPOSITORIES := https://curl.se/download \
 http://piotrkosoft.net/pub/mirrors/curl \
 https://ftp.icm.edu.pl/packages/curl \
 https://mirror.sobukus.de/files/src/curl

CURL_VERSION=8.21.0
USER_CPPFLAGS= \
        -D_XOPEN_SOURCE=600 \
        -D__BSD_VISIBLE=1
CURL_OPTIONS=--disable-shared --without-libpsl --disable-threaded-resolver --disable-ipv6 --with-openssl=$(AROS_DEVELOPER) --libdir=$(AROS_LIB) LIBS="-lmiami -lnet"

%fetch_and_build_gnu_development package=curl version=$(CURL_VERSION) \
    patch=yes package_repo="$(REPOSITORIES)" \
    extraoptions="$(CURL_OPTIONS)" \
    postinstall="development-curl-fixconfig"

#MM
development-curl-fixconfig :
	@for file in $(AROS_DEVELOPER)/bin/curl-config; \
	do \
	$(SED) -i -e 's@-lssl -lssl -lcrypto -lz@-lssl -lcrypto -lz@' $$file; \
	done; \
	$(ECHO) "SYS:Developer" > $(AROS_ENVARC)/SYS/Packages/Curl
