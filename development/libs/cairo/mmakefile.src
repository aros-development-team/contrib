include $(SRCDIR)/config/aros-contrib.cfg

CAIRO_VERSION := 1.18.4
ARCHBASE := cairo-$(CAIRO_VERSION)
REPOSITORIES := https://cairographics.org/releases \
 https://ftp.osuosl.org/pub/blfs/conglomeration/cairo

# Static library with the FreeType/fontconfig, PNG and PDF/PS/SVG backends;
# no X11, tests or tools. Meson finds pixman-1, freetype2, fontconfig, libpng
# and zlib through pkg-config.
CAIRO_OPTIONS := \
    -Dfreetype=enabled -Dfontconfig=enabled -Dpng=enabled -Dzlib=enabled \
    -Dxlib=disabled -Dxcb=disabled -Dquartz=disabled -Ddwrite=disabled \
    -Dtee=disabled -Dglib=disabled -Dspectre=disabled -Dlzo=disabled \
    -Dsymbol-lookup=disabled -Dtests=disabled -Dgtk2-utils=disabled \
    -Dgtk_doc=false

#MM- contrib-development : contrib-cairo
#MM- contrib-cairo : development-cairo

#MM- development-cairo : workbench-libs-freetype-complete contrib-fontconfig contrib-gfx-libs-pixman-includes

#MM development-cairo-meson : development-cairo-fetch

%fetch mmake=development-cairo-fetch archive=$(ARCHBASE) destination=$(PORTSDIR)/cairo \
    location=$(PORTSSOURCEDIR) archive_origins=$(REPOSITORIES) suffixes="tar.xz" \
    patches_specs=$(ARCHBASE)-aros.diff:$(ARCHBASE):-f,-p1

%create_patch mmake=development-cairo-create-patch \
    archive=$(ARCHBASE) suffixes="tar.xz" destination=$(PORTSDIR)/cairo

%build_with_meson mmake=development-cairo \
    srcdir=$(PORTSDIR)/cairo/$(ARCHBASE) prefix=$(AROS_DEVELOPER) \
    extraoptions="$(CAIRO_OPTIONS)"

%common
