+/// AROS: no softbuffer, so no window surface; the AROS shell renders through the headless
+/// path (`renderer::Headless::screenshot`) and blits the pixels itself. This compositor
+/// only satisfies the `compositor::Default` bound of `iced_program`.
+#[cfg(target_os = "aros")]
+mod without_softbuffer {
+    use super::*;
+
+    pub struct Compositor;
+
+    pub struct Surface;
+
+    impl crate::graphics::Compositor for Compositor {
+        type Renderer = Renderer;
+        type Surface = Surface;
+
+        async fn with_backend(
+            _settings: graphics::Settings,
+            _display: impl compositor::Display + Clone,
+            _compatible_window: impl compositor::Window + Clone,
+            _shell: Shell,
+            _backend: Option<&str>,
+        ) -> Result<Self, Error> {
+            Err(Error::BackendError(String::from(
+                "there is no window compositor on AROS; the AROS shell draws through the headless renderer",
+            )))
+        }
+
+        fn create_renderer(&self) -> Self::Renderer {
+            unreachable!("no AROS compositor is ever created")
+        }
+
+        fn create_surface<W: compositor::Window + Clone>(&mut self, _window: W, _width: u32, _height: u32) -> Self::Surface {
+            Surface
+        }
+
+        fn configure_surface(&mut self, _surface: &mut Self::Surface, _width: u32, _height: u32) {}
+
+        fn information(&self) -> Information {
+            Information { adapter: String::from("CPU"), backend: String::from("tiny-skia (AROS)") }
+        }
+
+        fn present(
+            &mut self,
+            _renderer: &mut Self::Renderer,
+            _surface: &mut Self::Surface,
+            _viewport: &Viewport,
+            _background_color: Color,
+            _on_pre_present: impl FnOnce(),
+        ) -> Result<(), compositor::SurfaceError> {
+            Ok(())
+        }
+
+        fn screenshot(&mut self, renderer: &mut Self::Renderer, viewport: &Viewport, background_color: Color) -> Vec<u8> {
+            super::screenshot(renderer, viewport, background_color)
+        }
+    }
+}
