+#[cfg(target_os = "aros")]
+use imp::tempdir_in;
+
+// AROS: posixc has neither the *at() calls rustix wants nor an atomic
+// replacing rename, so this is the plain sequence of std operations: the
+// file is written in its own subdirectory, the old one removed, the new one
+// renamed into place.
+#[cfg(target_os = "aros")]
+mod imp {
+    use std::io;
+    use std::path;
+    use std::sync::atomic::{AtomicU32, Ordering};
+
+    /// A temporary subdirectory, removed when dropped.
+    pub struct TempDir(path::PathBuf);
+
+    impl TempDir {
+        pub fn path(&self) -> &path::Path {
+            &self.0
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    pub fn tempdir_in(dir: &path::Path) -> io::Result<TempDir> {
+        static COUNTER: AtomicU32 = AtomicU32::new(0);
+        loop {
+            let name = format!(
+                ".atomicwrite{}-{}",
+                std::process::id(),
+                COUNTER.fetch_add(1, Ordering::Relaxed)
+            );
+            let path = dir.join(name);
+            match std::fs::create_dir(&path) {
+                Ok(()) => return Ok(TempDir(path)),
+                Err(e) if e.kind() == io::ErrorKind::AlreadyExists => continue,
+                Err(e) => return Err(e),
+            }
+        }
+    }
+
+    pub fn replace_atomic(src: &path::Path, dst: &path::Path) -> io::Result<()> {
+        match std::fs::remove_file(dst) {
+            Ok(()) => {}
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+            Err(e) => return Err(e),
+        }
+        std::fs::rename(src, dst)
+    }
+
+    pub fn move_atomic(src: &path::Path, dst: &path::Path) -> io::Result<()> {
+        if dst.exists() {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "the destination file exists",
+            ));
+        }
+        std::fs::rename(src, dst)
+    }
+}
+
