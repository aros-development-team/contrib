diff -ruN -x .cargo-ok -x .git -x target polling-3.11.0.orig/src/aros.rs polling-3.11.0/src/aros.rs
--- polling-3.11.0.orig/src/aros.rs	1970-01-01 01:00:00
+++ polling-3.11.0/src/aros.rs	2026-10-03 11:21:13
@@ -0,0 +1,187 @@
+//! Event queue for AROS.
+//!
+//! AROS has no `poll()`, so file descriptors cannot be watched. Instead the
+//! threads that do the I/O post readiness themselves, see
+//! [`PollerArosExt`](crate::os::aros::PollerArosExt).
+
+use std::io;
+use std::os::unix::io::{BorrowedFd, RawFd};
+use std::sync::{Condvar, Mutex};
+use std::time::Instant;
+
+use crate::{Event, PollMode};
+
+/// Interface to the posted event queue.
+#[derive(Debug)]
+pub struct Poller {
+    state: Mutex<State>,
+    cond: Condvar,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    queue: Vec<Event>,
+    notified: bool,
+}
+
+fn unsupported() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::Unsupported,
+        "AROS cannot poll file descriptors; post events instead",
+    )
+}
+
+impl Poller {
+    /// Creates a new poller.
+    pub fn new() -> io::Result<Poller> {
+        Ok(Poller {
+            state: Mutex::new(State::default()),
+            cond: Condvar::new(),
+        })
+    }
+
+    /// Whether this poller supports level-triggered events.
+    pub fn supports_level(&self) -> bool {
+        true
+    }
+
+    /// Whether this poller supports edge-triggered events.
+    pub fn supports_edge(&self) -> bool {
+        false
+    }
+
+    /// Adds a file descriptor.
+    pub fn add(&self, _fd: RawFd, _ev: Event, _mode: PollMode) -> io::Result<()> {
+        Err(unsupported())
+    }
+
+    /// Modifies an existing file descriptor.
+    pub fn modify(&self, _fd: BorrowedFd<'_>, _ev: Event, _mode: PollMode) -> io::Result<()> {
+        Err(unsupported())
+    }
+
+    /// Deletes a file descriptor.
+    pub fn delete(&self, _fd: BorrowedFd<'_>) -> io::Result<()> {
+        Err(unsupported())
+    }
+
+    /// Waits for posted events or a notification, until the deadline.
+    pub fn wait_deadline(&self, events: &mut Events, deadline: Option<Instant>) -> io::Result<()> {
+        let mut state = self.state.lock().unwrap();
+
+        while state.queue.is_empty() && !state.notified {
+            match deadline {
+                None => state = self.cond.wait(state).unwrap(),
+                Some(deadline) => {
+                    let now = Instant::now();
+                    if now >= deadline {
+                        break;
+                    }
+                    state = self.cond.wait_timeout(state, deadline - now).unwrap().0;
+                }
+            }
+        }
+
+        state.notified = false;
+        events.inner.append(&mut state.queue);
+
+        Ok(())
+    }
+
+    /// Sends a notification to wake up the current or next `wait()` call.
+    pub fn notify(&self) -> io::Result<()> {
+        self.state.lock().unwrap().notified = true;
+        self.cond.notify_all();
+        Ok(())
+    }
+
+    /// Queues an event and wakes up the current or next `wait()` call.
+    pub fn post(&self, ev: Event) -> io::Result<()> {
+        self.state.lock().unwrap().queue.push(ev);
+        self.cond.notify_all();
+        Ok(())
+    }
+}
+
+/// A list of reported I/O events.
+pub struct Events {
+    inner: Vec<Event>,
+}
+
+impl Events {
+    /// Creates an empty list.
+    pub fn with_capacity(cap: usize) -> Events {
+        Self {
+            inner: Vec::with_capacity(cap),
+        }
+    }
+
+    /// Iterates over I/O events.
+    pub fn iter(&self) -> impl Iterator<Item = Event> + '_ {
+        self.inner.iter().copied()
+    }
+
+    /// Clear the list.
+    pub fn clear(&mut self) {
+        self.inner.clear();
+    }
+
+    /// Get the capacity of the list.
+    pub fn capacity(&self) -> usize {
+        self.inner.capacity()
+    }
+}
+
+/// Extra information associated with an event.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub struct EventExtra {
+    hup: bool,
+    pri: bool,
+}
+
+impl EventExtra {
+    /// Creates an empty set of extra information.
+    #[inline]
+    pub const fn empty() -> Self {
+        Self {
+            hup: false,
+            pri: false,
+        }
+    }
+
+    /// Set the interrupt flag.
+    #[inline]
+    pub fn set_hup(&mut self, value: bool) {
+        self.hup = value;
+    }
+
+    /// Set the priority flag.
+    #[inline]
+    pub fn set_pri(&mut self, value: bool) {
+        self.pri = value;
+    }
+
+    /// Is this an interrupt event?
+    #[inline]
+    pub fn is_hup(&self) -> bool {
+        self.hup
+    }
+
+    /// Is this a priority event?
+    #[inline]
+    pub fn is_pri(&self) -> bool {
+        self.pri
+    }
+
+    /// Posted events carry no connection state.
+    #[inline]
+    pub fn is_connect_failed(&self) -> Option<bool> {
+        None
+    }
+
+    /// Posted events carry no error state.
+    #[inline]
+    pub fn is_err(&self) -> Option<bool> {
+        None
+    }
+}
