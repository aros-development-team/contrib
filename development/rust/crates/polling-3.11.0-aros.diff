diff -ruN -x .cargo-ok -x .git -x target polling-3.11.0.orig/src/os/aros.rs polling-3.11.0/src/os/aros.rs
--- polling-3.11.0.orig/src/os/aros.rs	1970-01-01 01:00:00
+++ polling-3.11.0/src/os/aros.rs	2026-10-03 11:21:13
@@ -0,0 +1,23 @@
+//! Functionality that is only available on AROS.
+
+use super::__private::PollerSealed;
+use crate::{Event, Poller};
+
+use std::io;
+
+/// Extension trait for the [`Poller`] type on AROS.
+///
+/// AROS cannot poll file descriptors, so the threads doing the I/O post
+/// readiness events to the poller themselves.
+///
+/// [`Poller`]: crate::Poller
+pub trait PollerArosExt: PollerSealed {
+    /// Post a new [`Event`] to the poller, waking up the current or next `wait()`.
+    fn post(&self, event: Event) -> io::Result<()>;
+}
+
+impl PollerArosExt for Poller {
+    fn post(&self, event: Event) -> io::Result<()> {
+        self.poller.post(event)
+    }
+}
