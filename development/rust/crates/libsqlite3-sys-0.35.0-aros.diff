 ** testing and sandboxing.  The following array holds the names and pointers
 ** to all overrideable system calls.
 */
+#ifdef __AROS__
+/* AROS: posixc has no POSIX byte-range locks (F_SETLK fails, so every
+** database open ends in SQLITE_IOERR_LOCK). Programs on AROS use a database
+** from one process at a time, so report locks as granted and the file as
+** unlocked; pass everything else through. */
+static int arosFcntl(int fd, int op, ...){
+  va_list ap;
+  void *arg;
+  va_start(ap, op);
+  arg = va_arg(ap, void*);
+  va_end(ap);
+  if( op==F_SETLK || op==F_SETLKW ) return 0;
+  if( op==F_GETLK ){
+    ((struct flock*)arg)->l_type = F_UNLCK;
+    return 0;
+  }
+  return fcntl(fd, op, arg);
+}
+#endif
