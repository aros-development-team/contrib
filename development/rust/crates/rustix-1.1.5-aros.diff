+// AROS has no `readv`/`writev`: transfer the first non-empty buffer, which is a valid short
+// read or write.
+#[cfg(target_os = "aros")]
+pub(crate) fn readv(fd: BorrowedFd<'_>, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+    match bufs.iter_mut().find(|buf| !buf.is_empty()) {
+        Some(buf) => unsafe { ret_usize(c::read(borrowed_fd(fd), buf.as_mut_ptr().cast(), buf.len())) },
+        None => Ok(0),
+    }
+}
+
+#[cfg(target_os = "aros")]
+pub(crate) fn writev(fd: BorrowedFd<'_>, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+    match bufs.iter().find(|buf| !buf.is_empty()) {
+        Some(buf) => unsafe { ret_usize(c::write(borrowed_fd(fd), buf.as_ptr().cast(), buf.len())) },
+        None => Ok(0),
+    }
