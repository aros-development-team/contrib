@@ -0,0 +1,41 @@
+use core::ffi::c_void;
+use core::ptr::NonNull;
+
+use super::DisplayHandle;
+
+/// Raw display handle for AROS.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct ArosDisplayHandle {}
+
+impl ArosDisplayHandle {
+    /// Create a new empty display handle.
+    pub fn new() -> Self {
+        Self {}
+    }
+}
+
+impl DisplayHandle<'static> {
+    /// Create an AROS display handle.
+    ///
+    /// As no data is borrowed by this handle, it is completely safe to create.
+    pub fn aros() -> Self {
+        // SAFETY: No data is borrowed.
+        unsafe { Self::borrow_raw(ArosDisplayHandle::new().into()) }
+    }
+}
+
+/// Raw window handle for AROS.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct ArosWindowHandle {
+    /// A pointer to an Intuition `struct Window`.
+    pub window: NonNull<c_void>,
+}
+
+impl ArosWindowHandle {
+    /// Create a new handle to an Intuition window.
+    pub fn new(window: NonNull<c_void>) -> Self {
+        Self { window }
+    }
+}
