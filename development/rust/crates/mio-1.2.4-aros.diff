+//! Waker for the `poll(2)` selector on AROS, where the selector waits in
+//! bsdsocket.library's `WaitSelect()` (`poll_signals()` of the C library
+//! layer), which also returns for exec signals of the waiting thread.
+//!
+//! Waking signals the thread that is polling, with a signal the thread
+//! allocates for the time of the poll: a runtime may poll from any of its
+//! threads, and a thread keeps no signal when it ends. With no socket to wait
+//! for, the selector waits on a condition variable instead, which needs no
+//! TCP/IP stack.
+
+use std::io;
+use std::os::fd::RawFd;
+use std::sync::{Condvar, Mutex};
+use std::time::Duration;
+
+use libc::c_void;
+
+extern "C" {
+    /// exec.library's base, set up by the C start-up code.
+    static SysBase: *mut c_void;
+
+    /// `poll()` that also returns when the calling thread gets one of the
+    /// exec signals in `*sigmask`, which then holds those that came.
+    fn poll_signals(
+        fds: *mut libc::pollfd,
+        nfds: libc::nfds_t,
+        timeout: libc::c_int,
+        sigmask: *mut u32,
+    ) -> libc::c_int;
+}
+
+/// exec.library function `lvo`, called with the base as the last argument
+/// (the AROS library ABI of x86_64 and riscv64).
+unsafe fn exec_vector(lvo: isize) -> *const c_void {
+    *(SysBase as *const *const c_void).offset(-lvo)
+}
+
+/// FindTask(NULL): the calling thread's task.
+unsafe fn this_task() -> usize {
+    let f: unsafe extern "C" fn(*const c_void, *mut c_void) -> *mut c_void =
+        std::mem::transmute(exec_vector(49));
+    f(std::ptr::null(), SysBase) as usize
+}
+
+/// Signal(task, mask).
+unsafe fn signal(task: usize, mask: u32) {
+    let f: unsafe extern "C" fn(*mut c_void, u32, *mut c_void) = std::mem::transmute(exec_vector(54));
+    f(task as *mut c_void, mask, SysBase)
+}
+
+/// SetSignal(new, mask): clears the calling thread's signals in `mask`.
+unsafe fn clear_signals(mask: u32) {
+    let f: unsafe extern "C" fn(u32, u32, *mut c_void) -> u32 = std::mem::transmute(exec_vector(51));
+    f(0, mask, SysBase);
+}
+
+/// AllocSignal(-1): a free signal of the calling thread, or -1.
+unsafe fn alloc_signal() -> i8 {
+    let f: unsafe extern "C" fn(i32, *mut c_void) -> i8 = std::mem::transmute(exec_vector(55));
+    f(-1, SysBase)
+}
+
+/// FreeSignal(bit).
+unsafe fn free_signal(bit: i8) {
+    let f: unsafe extern "C" fn(i32, *mut c_void) = std::mem::transmute(exec_vector(56));
+    f(bit as i32, SysBase)
+}
+
+#[derive(Debug)]
+struct State {
+    woken: bool,
+    /// The task waiting in `poll()` and its signal.
+    poller: Option<(usize, u32)>,
+}
+
+#[derive(Debug)]
+pub(crate) struct Waker {
+    state: Mutex<State>,
+    wakeup: Condvar,
+}
+
+impl Waker {
+    pub(crate) fn new_unregistered() -> io::Result<Waker> {
+        Ok(Waker {
+            state: Mutex::new(State {
+                woken: false,
+                poller: None,
+            }),
+            wakeup: Condvar::new(),
+        })
+    }
+
+    pub(crate) fn wake(&self) -> io::Result<()> {
+        let mut state = self.state.lock().unwrap();
+        state.woken = true;
+        if let Some((task, mask)) = state.poller {
+            // the poller clears its poller entry under the lock, so the
+            // task is still waiting or about to clear the signal
+            unsafe { signal(task, mask) };
+        }
+        drop(state);
+        self.wakeup.notify_all();
+        Ok(())
+    }
+
+    /// Only non-`None` for the `pipe(2)`- and `eventfd(2)`-based `Waker`s.
+    pub(crate) fn fd(&self) -> Option<RawFd> {
+        None
+    }
+
+    pub(crate) fn woken(&self) -> bool {
+        self.state.lock().unwrap().woken
+    }
+
+    pub(crate) fn ack_and_reset(&self) {
+        self.state.lock().unwrap().woken = false;
+    }
+
+    /// Waits as `poll(2)` for `fds`, until `timeout` or a `wake()`, and gives
+    /// the number of descriptors with events.
+    pub(crate) fn poll(&self, fds: &mut [libc::pollfd], timeout: Option<Duration>) -> io::Result<usize> {
+        let mut state = self.state.lock().unwrap();
+        if fds.is_empty() {
+            if !state.woken {
+                match timeout {
+                    None => drop(self.wakeup.wait_while(state, |s| !s.woken).unwrap()),
+                    Some(to) => drop(self.wakeup.wait_timeout_while(state, to, |s| !s.woken).unwrap()),
+                }
+            }
+            return Ok(0);
+        }
+
+        let bit = unsafe { alloc_signal() };
+        if bit < 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::Other,
+                "no free signal for the selector on this thread",
+            ));
+        }
+        let mask = 1u32 << bit;
+        let timeout = if state.woken { Some(Duration::ZERO) } else { timeout };
+        // Round up, so that a short timeout does not become a busy poll.
+        let ms = timeout
+            .map(|to| {
+                let ms = to
+                    .checked_add(Duration::from_nanos(999_999))
+                    .unwrap_or(to)
+                    .as_millis();
+                ms.min(libc::c_int::MAX as u128) as libc::c_int
+            })
+            .unwrap_or(-1);
+        state.poller = Some((unsafe { this_task() }, mask));
+        drop(state);
+
+        let res = loop {
+            let mut sigs = mask;
+            let n = unsafe { poll_signals(fds.as_mut_ptr(), fds.len() as libc::nfds_t, ms, &mut sigs) };
+            if n >= 0 {
+                break Ok(n as usize);
+            }
+            let err = io::Error::last_os_error();
+            if err.raw_os_error() != Some(libc::EAGAIN) {
+                break Err(err);
+            }
+        };
+
+        // From here no wake() signals this thread.
+        self.state.lock().unwrap().poller = None;
+        unsafe {
+            // a wake() that came as the wait ended
+            clear_signals(mask);
+            free_signal(bit);
+        }
+        res
+    }
+}
