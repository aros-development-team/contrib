+    /// Finds the depth image globals that only `textureLoad` reads (see
+    /// [`Self::depth_fetch_images`]): every function's `ImageLoad` of a depth global counts it
+    /// in, an `ImageSample` with a depth reference counts it out again.
+    fn collect_depth_fetch_images(&mut self) {
+        let module = self.module;
+        let is_depth = |handle: Handle<crate::GlobalVariable>| {
+            matches!(
+                module.types[module.global_variables[handle].ty].inner,
+                TypeInner::Image {
+                    class: crate::ImageClass::Depth { .. },
+                    ..
+                }
+            )
+        };
+        let mut loaded = crate::FastHashSet::default();
+        let mut compared = crate::FastHashSet::default();
+        let functions = module
+            .functions
+            .iter()
+            .map(|(_, f)| f)
+            .chain(module.entry_points.iter().map(|ep| &ep.function));
+        for function in functions {
+            for (_, expr) in function.expressions.iter() {
+                let (image, is_load) = match *expr {
+                    crate::Expression::ImageLoad { image, .. } => (image, true),
+                    crate::Expression::ImageSample {
+                        image,
+                        depth_ref: Some(_),
+                        ..
+                    } => (image, false),
+                    _ => continue,
+                };
+                if let crate::Expression::GlobalVariable(handle) = function.expressions[image] {
+                    if is_depth(handle) {
+                        if is_load {
+                            loaded.insert(handle);
+                        } else {
+                            compared.insert(handle);
+                        }
+                    }
+                }
+            }
+        }
+        self.depth_fetch_images = loaded.difference(&compared).copied().collect();
+    }
