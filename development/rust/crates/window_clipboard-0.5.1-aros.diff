@@ -0,0 +1,50 @@
+//! AROS: the clipboard (clipboard.device unit 0, IFF FTXT) through the C
+//! glue in `aros-gui-sys`. Its text is ISO-8859-1.
+
+use crate::ClipboardProvider;
+
+use raw_window_handle::HasDisplayHandle;
+use std::error::Error;
+
+struct Aros;
+
+pub unsafe fn connect<W: HasDisplayHandle>(
+    _window: &W,
+) -> Result<Box<dyn ClipboardProvider>, Box<dyn Error>> {
+    Ok(Box::new(Aros))
+}
+
+impl ClipboardProvider for Aros {
+    fn read(&self) -> Result<String, Box<dyn Error>> {
+        let mut len: i32 = 0;
+        let text = unsafe { aros_gui_sys::aros_gui_clip_read(&mut len) };
+        if text.is_null() {
+            return Err(Box::new(ArosClipboardError::Empty));
+        }
+        let bytes = unsafe { std::slice::from_raw_parts(text, len.max(0) as usize) };
+        let contents: String = bytes.iter().map(|&b| char::from(b)).collect();
+        unsafe { aros_gui_sys::aros_gui_clip_free(text) };
+        Ok(contents)
+    }
+
+    fn write(&mut self, contents: String) -> Result<(), Box<dyn Error>> {
+        let bytes: Vec<u8> = contents
+            .chars()
+            .map(|c| u8::try_from(u32::from(c)).unwrap_or(b'?'))
+            .collect();
+        let rc = unsafe { aros_gui_sys::aros_gui_clip_write(bytes.as_ptr(), bytes.len() as i32) };
+        if rc == 0 {
+            Ok(())
+        } else {
+            Err(Box::new(ArosClipboardError::Write))
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, thiserror::Error)]
+enum ArosClipboardError {
+    #[error("the clipboard holds no text")]
+    Empty,
+    #[error("the clipboard could not be written")]
+    Write,
+}
