 /// feature flag is not enabled.
 #[track_caller]
 pub fn signal(kind: SignalKind) -> io::Result<Signal> {
+    // AROS: the runtime has no I/O (and so no signal) driver; report that instead of
+    // panicking in whatever task asked for the signal.
+    if cfg!(target_os = "aros") {
+        let _ = kind;
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "signal handling is not available on AROS (no I/O driver)",
+        ));
+    }
     let handle = scheduler::Handle::current();
     let rx = signal_with_handle(kind, handle.driver().signal())?;
 
