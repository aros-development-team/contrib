+static inline bool skip_iprefix_mem(const char *buf, size_t len,
+				   const char *prefix,
+				   const char **out, size_t *outlen)
+{
+	do {
+		if (!*prefix) {
+			*out = buf;
+			*outlen = len;
+			return true;
+		}
+	} while (len-- > 0 && tolower(*buf++) == tolower(*prefix++));
+	return false;
