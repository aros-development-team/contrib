+#define skip_iprefix(str, prefix, out) \
+	skip_iprefix_impl((str), (prefix), CONST_OUTPARAM((str), (out)))
+static inline bool skip_iprefix_impl(const char *str, const char *prefix,
+				     const char **out)
+{
+	do {
+		if (!*prefix) {
+			*out = str;
+			return true;
+		}
+	} while (tolower(*str++) == tolower(*prefix++));
+	return false;
