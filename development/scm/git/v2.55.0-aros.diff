+
+### Testing rules
+
+test: all
+	$(MAKE) -C t/ all
+ifdef TEST_CONTRIB_TOO
+	$(MAKE) -C contrib/ test
+endif
+
+perf: all
+	$(MAKE) -C t/perf/ all
