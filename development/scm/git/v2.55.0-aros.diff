+GIT-PYTHON-VARS: FORCE
+	@VARS='$(TRACK_PYTHON)'; \
+	    if test x"$$VARS" != x"`cat $@ 2>/dev/null`" ; then \
+		echo >&2 "    * new Python interpreter location"; \
+		echo "$$VARS" >$@; \
+            fi
+endif
