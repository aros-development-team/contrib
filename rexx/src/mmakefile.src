#   $Id$
#
#   Makefile to make Rexx.

include $(SRCDIR)/config/aros-contrib.cfg

FILES := \
	main \
	rexx \
	compile \
	expr \
	template \
	interpre \
	nextsymb \
	rexxfunc \
	builtin \
	rxstr \
	rxconv \
	rxmath \
	rxword \
	rxfiles \
	address \
	variable \
	trace \
	error \
	stack \
	dqueue \
	bintree \
	bmem

EXEDIR := $(AROS_CONTRIB)/Rexx

# BREXX predates C23, where bool became a keyword: it typedefs bool to
# int and relies on int and bool being interchangeable.
USER_CFLAGS := $(CFLAGS_GNU17) -DAROS -I$(SRCDIR)/$(CURDIR)/../inc -DALIGNED

#MM contrib-rexx-program : includes linklibs linklibs-rexxlstring

%build_prog mmake=contrib-rexx-program \
    progname=rx targetdir=$(EXEDIR) \
    files=$(FILES) uselibs="rexxlstring"

%common
