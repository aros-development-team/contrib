@@ -17,6 +17,28 @@
 #include <rfb/rfbregion.h>
 #include "private.h"
 
+#ifdef __AROS__
+#include <proto/exec.h>
+#include <proto/bsdsocket.h>
+#include <bsdsocket/socketbasetags.h>
+#include <errno.h>
+struct Library *SocketBase = NULL;
+
+/* bsdsocket.library only updates the caller's errno if asked to; without
+   this the EWOULDBLOCK/EAGAIN checks in the Read/Write/PeekExact retry
+   loops see a stale errno and treat every partial transfer as fatal */
+static struct Library *rfbAROSOpenSocket(void)
+{
+    struct Library *base = OpenLibrary("bsdsocket.library", 0);
+    if (base)
+    {
+        struct Library *SocketBase = base;   /* for the SocketBaseTags call */
+        SocketBaseTags(SBTC_ERRNOPTR(sizeof(errno)), (IPTR)&errno, TAG_DONE);
+    }
+    return base;
+}
+#endif
+
 #include <stdarg.h>
 #include <errno.h>
 
