
include $(SRCDIR)/config/aros-contrib.cfg

LIBVNCSERVER_VERSION := 0.9.14
VNCSERVER_REPOSITORIES := https://github.com/LibVNC/libvncserver/archive/refs/tags
VNCSERVER_ARCHBASE := LibVNCServer-$(LIBVNCSERVER_VERSION)
VNCSERVER_ARCHSUFFIX := "tar.gz"
# The github tag tarball unpacks to libvncserver-<tag>, not <tag>
VNCSERVER_SRCSUBDIR := libvncserver-$(VNCSERVER_ARCHBASE)
VNCSERVER_PATCHSPEC := $(VNCSERVER_ARCHBASE)-aros.diff:$(VNCSERVER_SRCSUBDIR):-f,-p1
VNCSERVER_ARCHSRCDIR := $(PORTSDIR)/libvncserver/$(VNCSERVER_SRCSUBDIR)

%fetch mmake=contrib-networking-libvncserver-fetch archive=$(VNCSERVER_ARCHBASE) \
    destination=$(PORTSDIR)/libvncserver location=$(PORTSSOURCEDIR) \
    archive_origins=$(VNCSERVER_REPOSITORIES) suffixes=$(VNCSERVER_ARCHSUFFIX) \
    patches_specs=$(VNCSERVER_PATCHSPEC)

%create_patch mmake=contrib-networking-libvncserver-create-patch \
    archive=$(VNCSERVER_ARCHBASE) suffixes=$(VNCSERVER_ARCHSUFFIX) \
    srcdir=$(VNCSERVER_SRCSUBDIR) destination=$(PORTSDIR)/libvncserver

NOWARN_FLAGS := $(NOWARN_UNINITIALIZED) $(NOWARN_PARENTHESES) \
    $(NOWARN_UNUSED) $(NOWARN_UNUSED_BUT_SET_VARIABLE) \
    $(NOWARN_DEPRECATED_DECLARATIONS) $(NOWARN_DISCARDED_QUALIFIERS)
USER_CFLAGS := $(NOWARN_FLAGS)
# __CONFIG_ROADSHOW__ exposes bsdsocket.library's getaddrinfo()/getnameinfo()
# in <proto/bsdsocket.h>, which the IPv6 support needs
USER_CPPFLAGS := -D_GNU_SOURCE=1 -D__CONFIG_ROADSHOW__
USER_INCLUDES := \
    -I$(VNCSERVER_ARCHSRCDIR) \
    -I$(VNCSERVER_ARCHSRCDIR)/common \
    -I$(VNCSERVER_ARCHSRCDIR)/libvncserver

# websockets/ws_decode/base64 and the rfbssl backends are left out:
# no TLS and no websockets in the AROS configuration (see the rfbconfig.h
# added by the -aros.diff). libvncserver/sockets.c and common/sockets.c
# share a basename, which the flattened object naming cannot hold - both
# are compiled through the local rfb_sockets.c / common_sockets.c wrappers.
VNCSERVERLIB_FILES := \
    main \
    rfbserver \
    rfbregion \
    auth \
    stats \
    corre \
    hextile \
    rre \
    translate \
    cutpaste \
    httpd \
    cursor \
    font \
    draw \
    selbox \
    cargs \
    ultra \
    scale \
    zlib \
    zrle \
    zrleoutstream \
    zrlepalettehelper \
    tight

VNCSERVERLIB_COMMON_FILES := \
    d3des \
    vncauth \
    minilzo \
    turbojpeg \
    sha1 \
    crypto_included

#MM contrib-networking-libvncserver : \
#MM     includes \
#MM     linklibs \
#MM     network-includes \
#MM     contrib-networking-libvncserver-fetch \
#MM     contrib-networking-libvncserver-includes

#MM- contrib-networking-libs : contrib-networking-libvncserver

%build_linklib mmake=contrib-networking-libvncserver \
    libname=vncserver \
    files="$(addprefix $(VNCSERVER_ARCHSRCDIR)/libvncserver/,$(VNCSERVERLIB_FILES)) $(addprefix $(VNCSERVER_ARCHSRCDIR)/common/,$(VNCSERVERLIB_COMMON_FILES)) rfb_sockets common_sockets"

VNCSERVER_INCLUDE_FILES := \
    rfb.h \
    rfbproto.h \
    rfbconfig.h \
    rfbregion.h \
    rfbclient.h \
    keysym.h \
    threading.h \
    default8x16.h

#MM contrib-networking-libvncserver-includes : contrib-networking-libvncserver-fetch
%copy_includes mmake=contrib-networking-libvncserver-includes \
    dir=$(VNCSERVER_ARCHSRCDIR)/rfb path=rfb includes="$(VNCSERVER_INCLUDE_FILES)"

%common
