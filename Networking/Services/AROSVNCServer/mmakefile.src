#   $Id$

include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-networking : contrib-networking-services
#MM- contrib-networking-services : contrib-networking-services-arosvncserver

#MM contrib-networking-services-arosvncserver : \
#MM     includes \
#MM     linklibs \
#MM     network-includes \
#MM     arostcp-linklibs-netlib \
#MM     workbench-libs-jpeg-linklib \
#MM     contrib-networking-libvncserver \
#MM     contrib-networking-services-arosvncserver-cpy \
#MM     contrib-networking-services-arosvncserver-icons \
#MM     contrib-networking-services-arosvncserver-envpackage

# Package resources (docs, icons, .info) live under the contrib tree...
TARGETDIR := $(AROS_CONTRIB)/Networking/Services/AROSVNCServer
# ...but the daemon itself installs alongside the other managed network
# services (matching dhcpd), so the service manager can launch it.
SERVICEDIR := $(AROS_SYSTEM)/Network/Services

NOWARN_FLAGS := $(NOWARN_UNINITIALIZED) $(NOWARN_PARENTHESES) \
    $(NOWARN_UNUSED) $(NOWARN_UNUSED_BUT_SET_VARIABLE) $(NOWARN_DEPRECATED_DECLARATIONS)
USER_CFLAGS := $(NOWARN_FLAGS)
USER_CPPFLAGS := -D_GNU_SOURCE=1 -DUSE_NEWFRAMEBUFFER
USER_INCLUDES := \
    -iquote $(SRCDIR)/$(CURDIR)/src

FILES := \
    src/ArosVNCserver \
    src/AVS_gui \
    src/ievents \
    src/ilace \
    src/ParseFBThread \
    src/thread_compat

%build_prog mmake=contrib-networking-services-arosvncserver \
    progname=AROSVNCServer files="$(FILES)" \
    targetdir=$(SERVICEDIR) \
    uselibs="mui vncserver net pthread jpeg png z m"

%copy_files_q mmake=contrib-networking-services-arosvncserver-cpy \
    files="Read.Me license AROSVNCServer.info" dst=$(TARGETDIR)

%copy_dir_recursive mmake=contrib-networking-services-arosvncserver-icons \
    src=icons dst=$(TARGETDIR)/Icons

# Register the package with the installer.  (AROSVNCServer is launched by the
# AROSTCP service manager via db/services.d/arosvnc, not a boot-time
# Package-Startup, so no startup script is installed.)
$(AROS_PACKAGES)/AROSVNCServer:
	%fileactionmsg msg="Creating" file="$(AROS_PACKAGES)/AROSVNCServer"
	%mkdirs_q $(AROS_PACKAGES)
	@$(ECHO) "SYS:Extras/Networking/Services/AROSVNCServer" >$(AROS_PACKAGES)/AROSVNCServer

#MM
contrib-networking-services-arosvncserver-envpackage : $(AROS_PACKAGES)/AROSVNCServer
	@$(NOP)

%common
