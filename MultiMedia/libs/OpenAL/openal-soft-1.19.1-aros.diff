+/*
+ * OpenAL's own error log writes through the C library's stderr, which is
+ * not usable from inside openal.library: the backend reports its errors on
+ * the debug output instead.
+ */
+#define AHI_ERR(...) bug("[OpenAL:AHI] " __VA_ARGS__)
+
+/*
+ * "AHI Default" plays through the AHI Music unit - the mode and frequency
+ * chosen for applications in AHI preferences - using the low-level API.
+ * "AHI Unit 0" to "AHI Unit 3" write to that ahi.device unit instead; they
+ * are used only when an application asks for one by name, or when
+ * "[ahi] unit = N" in the configuration makes one the default.
+ */
+static const ALCchar ahi_device[] = "AHI Default";
+static const ALCchar *const ahi_unit_names[] = {
+    "AHI Unit 0", "AHI Unit 1", "AHI Unit 2", "AHI Unit 3"
+};
+#define AHI_UNIT_COUNT  (int)(sizeof(ahi_unit_names) / sizeof(ahi_unit_names[0]))
+#define AHI_MUSIC_UNIT  (-1)
+
+static const char *ahi_driver = "ahi.device";
+static int ahi_default_unit = AHI_MUSIC_UNIT;
+
+typedef struct ALCplaybackAHI {
+	DERIVE_FROM_TYPE(ALCbackend);
+
+	int unit;		/* AHI_MUSIC_UNIT, or the ahi.device unit written to */
+	int ahi_fmt;
+
+	struct MsgPort *ahip;
+	struct AHIRequest *ahir[2];
+	struct AHIRequest *link;
+
+	/* Music unit (low-level API) */
+	struct Library *ahibase;
+	struct AHIAudioCtrl *actrl;
+	struct Hook soundhook;
+	struct AHISampleInfo sample[2];
+	BOOL sounds_loaded;
+	ULONG mixfreq;
+	volatile ULONG nextsound;
+	volatile ULONG queuedsound;	/* the sound the hook queued last: the one to refill */
+	int frames;			/* sample frames per AHI sound */
+	struct Task * volatile mixtask;
+	BYTE mixsig;
+
+	ALubyte *mix_data[2];
+	int data_size;
+
+	volatile int killNow;
+	althrd_t thread;
+} ALCplaybackAHI;
+
+static int ALCplaybackAHI_mixerProc(void *ptr);
+
+static void ALCplaybackAHI_Construct(ALCplaybackAHI *self, ALCdevice *device);
+static void ALCplaybackAHI_Destruct(ALCplaybackAHI *self);
+static ALCenum ALCplaybackAHI_open(ALCplaybackAHI *self, const ALCchar *name);
+static void ALCplaybackAHI_close(ALCplaybackAHI *self);
+static ALCboolean ALCplaybackAHI_reset(ALCplaybackAHI *self);
+static ALCboolean ALCplaybackAHI_start(ALCplaybackAHI *self);
+static void ALCplaybackAHI_stop(ALCplaybackAHI *self);
+static DECLARE_FORWARD2(ALCplaybackAHI, ALCbackend, ALCenum, captureSamples, ALCvoid*, ALCuint)
+static DECLARE_FORWARD(ALCplaybackAHI, ALCbackend, ALCuint, availableSamples)
+static DECLARE_FORWARD(ALCplaybackAHI, ALCbackend, ClockLatency, getClockLatency)
+static DECLARE_FORWARD(ALCplaybackAHI, ALCbackend, void, lock)
+static DECLARE_FORWARD(ALCplaybackAHI, ALCbackend, void, unlock)
+DECLARE_DEFAULT_ALLOCATORS(ALCplaybackAHI)
+DEFINE_ALCBACKEND_VTABLE(ALCplaybackAHI);
+
+/*
+ * Called by AHI when a sound starts playing: queue the other buffer to
+ * follow it and wake the mixer thread to refill that one meanwhile.
+ */
+AROS_UFH3(ULONG, ALCplaybackAHI_soundFunc,
+	AROS_UFHA(struct Hook *, hook, A0),
+	AROS_UFHA(struct AHIAudioCtrl *, actrl, A2),
+	AROS_UFHA(struct AHISoundMessage *, smsg, A1))
+{
+	AROS_USERFUNC_INIT
+
+	ALCplaybackAHI *self = (ALCplaybackAHI *)hook->h_Data;
+	struct Library *AHIBase = self->ahibase;
+	struct Task *task = self->mixtask;
+
+	(void)smsg;
+	AHI_SetSound(0, self->nextsound, 0, 0, actrl, AHISF_NONE);
+	self->queuedsound = self->nextsound;
+	self->nextsound ^= 1;
+	if(task)
+		Signal(task, 1UL << self->mixsig);
+	return 0;
+
+	AROS_USERFUNC_EXIT
+}
+
+static int ALCplaybackAHI_musicProc(ALCplaybackAHI *self) {
+	ALCdevice *device = STATIC_CAST(ALCbackend, self)->mDevice;
+	struct Library *AHIBase = self->ahibase;
+	ALint frames = self->frames;
+
+	self->mixsig = AllocSignal(-1);
+	if(self->mixsig == -1)
+		return 1;
+
+	ALCplaybackAHI_lock(self);
+	aluMixData(device, self->mix_data[0], frames);
+	ALCplaybackAHI_unlock(self);
+
+	self->nextsound = 1;
+	self->queuedsound = 0;
+	self->mixtask = FindTask(NULL);
+	AHI_Play(self->actrl,
+		AHIP_BeginChannel, 0,
+		AHIP_Freq,   self->mixfreq,
+		AHIP_Vol,    0x10000,
+		AHIP_Pan,    0x8000,
+		AHIP_Sound,  0,
+		AHIP_EndChannel, 0,
+		TAG_DONE);
+	if(AHI_ControlAudio(self->actrl, AHIC_Play, TRUE, TAG_DONE) != AHIE_OK) {
+		AHI_ERR("AHIC_Play failed\n");
+		self->mixtask = NULL;
+		FreeSignal(self->mixsig);
+		self->mixsig = -1;
+		return 1;
+	}
+
+	while(!self->killNow && ATOMIC_LOAD(&device->Connected, almemory_order_acquire)) {
+		ULONG sigs = Wait((1UL << self->mixsig) | SIGBREAKF_CTRL_C);
+		if(self->killNow)
+			break;
+		if(!(sigs & (1UL << self->mixsig)))
+			continue;
+		/* Refill the sound the hook queued last: it plays after the current
+		   one. Several hook calls can arrive as one wake-up, so the buffer
+		   is taken from the hook rather than alternated here. */
+		ALCplaybackAHI_lock(self);
+		aluMixData(device, self->mix_data[self->queuedsound], frames);
+		ALCplaybackAHI_unlock(self);
+	}
+
+
+	AHI_ControlAudio(self->actrl, AHIC_Play, FALSE, TAG_DONE);
+	self->mixtask = NULL;
+	FreeSignal(self->mixsig);
+	self->mixsig = -1;
+
+	return 0;
+}
+
+static int ALCplaybackAHI_unitProc(ALCplaybackAHI *self) {
+	ALCdevice *device = STATIC_CAST(ALCbackend, self)->mDevice;
+	ALint frameSize;
+	ALint cb = 0;
+
+	/* Replies must signal this task, so they come to a port of its own
+	   rather than the one created by the task that opened the device. */
+	struct MsgPort *ahip = CreateMsgPort();
+	if(ahip == NULL)
+		return 1;
+	self->ahir[0]->ahir_Std.io_Message.mn_ReplyPort = ahip;
+	self->ahir[1]->ahir_Std.io_Message.mn_ReplyPort = ahip;
+
+	frameSize = FrameSizeFromDevFmt(device->FmtChans, device->FmtType, device->AmbiOrder);
+
+	while(!self->killNow && ATOMIC_LOAD(&device->Connected, almemory_order_acquire)) {
+		ALint len = self->data_size;
+		ALubyte *WritePtr = self->mix_data[cb];
+		struct AHIRequest *ahir = self->ahir[cb];
+
+		aluMixData(device, WritePtr, len/frameSize);
+
+		ahir->ahir_Std.io_Message.mn_Node.ln_Pri = 127;
+		ahir->ahir_Std.io_Command = CMD_WRITE;
+		ahir->ahir_Std.io_Data    = WritePtr;
+		ahir->ahir_Std.io_Length  = len;
+		ahir->ahir_Frequency = device->Frequency;
+		ahir->ahir_Type      = self->ahi_fmt;
+		ahir->ahir_Volume    = 0x10000;
+		ahir->ahir_Position  = 0x8000;
+		ahir->ahir_Link      = self->link;
+		SendIO((struct IORequest*)ahir);
+
+		if(self->link != NULL) {
+			WaitIO((struct IORequest*)self->link);
+		}
+
+		self->link = ahir;
+		cb ^= 1;
+	}
+
+	if(self->link != NULL) {
+		WaitIO((struct IORequest*)self->link);
+		self->link = NULL;
+	}
+
+	self->ahir[0]->ahir_Std.io_Message.mn_ReplyPort = self->ahip;
+	self->ahir[1]->ahir_Std.io_Message.mn_ReplyPort = self->ahip;
+	DeleteMsgPort(ahip);
+
+	return 0;
+}
+
+static int ALCplaybackAHI_mixerProc(void *ptr) {
+	ALCplaybackAHI *self = (ALCplaybackAHI*)ptr;
+
+	SetRTPriority();
+	althrd_setname(althrd_current(), MIXER_THREAD_NAME);
+
+	if(self->unit == AHI_MUSIC_UNIT)
+		return ALCplaybackAHI_musicProc(self);
+	return ALCplaybackAHI_unitProc(self);
+}
+
+static void ALCplaybackAHI_Construct(ALCplaybackAHI *self, ALCdevice *device) {
+	ALCbackend_Construct(STATIC_CAST(ALCbackend, self), device);
+	SET_VTABLE2(ALCplaybackAHI, ALCbackend, self);
+	self->unit = AHI_MUSIC_UNIT;
+	self->ahi_fmt = -1;
+	self->mixsig = -1;
+}
+
+static int get_ahi_format(ALCdevice *device) {
+	switch(ChannelsFromDevFmt(device->FmtChans, device->AmbiOrder)) {
+	case 1:
+		switch(device->FmtType) {
+		case DevFmtUByte:
+			device->FmtType = DevFmtByte;
+		case DevFmtByte:
+			return AHIST_M8S;
+		case DevFmtUShort:
+			device->FmtType = DevFmtShort;
+		case DevFmtShort:
+			return AHIST_M16S;
+		case DevFmtUInt:
+		case DevFmtFloat:
+			device->FmtType = DevFmtInt;
+		case DevFmtInt:
+			return AHIST_M32S;
+		default:
+			break;
+		}
+		break;
+	case 2:
+		switch(device->FmtType) {
+		case DevFmtUByte:
+			device->FmtType = DevFmtByte;
+		case DevFmtByte:
+			return AHIST_S8S;
+		case DevFmtUShort:
+			device->FmtType = DevFmtShort;
+		case DevFmtShort:
+			return AHIST_S16S;
+		case DevFmtUInt:
+		case DevFmtFloat:
+			device->FmtType = DevFmtInt;
+		case DevFmtInt:
+			return AHIST_S32S;
+		default:
+			break;
+		}
+		break;
+	default:
+		break;
+	}
+	AHI_ERR("unknown format, channels %d type %d\n", device->FmtChans, device->FmtType);
+	return -1;
+}
+
+/* The Music unit is driven with 16-bit mono or stereo dynamic sounds. */
+static int get_ahi_music_format(ALCdevice *device) {
+	if(device->FmtChans != DevFmtMono)
+		device->FmtChans = DevFmtStereo;
+	device->FmtType = DevFmtShort;
+	return (device->FmtChans == DevFmtMono) ? AHIST_M16S : AHIST_S16S;
+}
+
+static ALCenum ALCplaybackAHI_open(ALCplaybackAHI *self, const ALCchar *name) {
+	ALCdevice *device = STATIC_CAST(ALCbackend, self)->mDevice;
+	int unit, i;
+
+	if(!name || strcmp(name, ahi_device) == 0) {
+		name = ahi_device;
+		unit = ahi_default_unit;
+	} else {
+		for(i = 0; i < AHI_UNIT_COUNT; i++) {
+			if(strcmp(name, ahi_unit_names[i]) == 0)
+				break;
+		}
+		if(i == AHI_UNIT_COUNT)
+			return ALC_INVALID_VALUE;
+		unit = i;
+	}
+
+	self->killNow = 0;
+	self->unit = unit;
+
+	self->ahip = CreateMsgPort();
+	if(self->ahip == NULL)
+		return ALC_OUT_OF_MEMORY;
+
+	self->ahir[0] = (struct AHIRequest*)CreateIORequest(self->ahip, sizeof(struct AHIRequest));
+	if(self->ahir[0] == NULL) {
+		DeleteMsgPort(self->ahip);
+		self->ahip = NULL;
+		return ALC_OUT_OF_MEMORY;
+	}
+	self->ahir[0]->ahir_Version = 4;
+
+	if(OpenDevice(ahi_driver, (unit == AHI_MUSIC_UNIT) ? AHI_NO_UNIT : unit,
+	              (struct IORequest *)self->ahir[0], 0) != 0) {
+		AHI_ERR("could not open %s unit %d\n", ahi_driver, unit);
+		DeleteIORequest((struct IORequest *)self->ahir[0]);
+		self->ahir[0] = NULL;
+		DeleteMsgPort(self->ahip);
+		self->ahip = NULL;
+		return ALC_INVALID_VALUE;
+	}
+
+	if(unit == AHI_MUSIC_UNIT) {
+		self->ahibase = (struct Library *)self->ahir[0]->ahir_Std.io_Device;
+		self->ahi_fmt = get_ahi_music_format(device);
+	} else {
+		self->ahir[1] = (struct AHIRequest*)CreateIORequest(self->ahip, sizeof(struct AHIRequest));
+		if(self->ahir[1] == NULL) {
+			ALCplaybackAHI_close(self);
+			return ALC_OUT_OF_MEMORY;
+		}
+		CopyMem(self->ahir[0], self->ahir[1], sizeof(struct AHIRequest));
+
+		self->ahi_fmt = get_ahi_format(device);
+		if(self->ahi_fmt == -1) {
+			ALCplaybackAHI_close(self);
+			return ALC_INVALID_VALUE;
+		}
+	}
+
+	alstr_copy_cstr(&device->DeviceName, name);
+
+	return ALC_NO_ERROR;
+}
+
+static void ALCplaybackAHI_close(ALCplaybackAHI *self) {
+	if(self->actrl) {
+		struct Library *AHIBase = self->ahibase;
+		AHI_FreeAudio(self->actrl);
+		self->actrl = NULL;
+	}
+	self->ahibase = NULL;
+
+	if(self->ahir[0])
+		CloseDevice((struct IORequest*)self->ahir[0]);
+	if(self->ahir[1])
+		DeleteIORequest((struct IORequest*)self->ahir[1]);
+	if(self->ahir[0])
+		DeleteIORequest((struct IORequest*)self->ahir[0]);
+	self->ahir[0] = self->ahir[1] = NULL;
+
+	if(self->ahip)
+		DeleteMsgPort(self->ahip);
+	self->ahip = NULL;
+
+	self->ahi_fmt = -1;
+}
+
+/* The backend interface has no close: releasing the device is the destructor's job. */
+static void ALCplaybackAHI_Destruct(ALCplaybackAHI *self) {
+	ALCplaybackAHI_close(self);
+	ALCbackend_Destruct(STATIC_CAST(ALCbackend, self));
+}
+
+static ALCboolean ALCplaybackAHI_reset(ALCplaybackAHI *self) {
+	ALCdevice *device = STATIC_CAST(ALCbackend, self)->mDevice;
+
+	if(self->unit == AHI_MUSIC_UNIT) {
+		struct Library *AHIBase = self->ahibase;
+		IPTR freq = 0;
+
+		if(self->actrl) {
+			AHI_FreeAudio(self->actrl);
+			self->actrl = NULL;
+		}
+		self->soundhook.h_Entry = (HOOKFUNC)ALCplaybackAHI_soundFunc;
+		self->soundhook.h_Data = self;
+		self->actrl = AHI_AllocAudio(
+			AHIA_AudioID,   AHI_DEFAULT_ID,
+			AHIA_MixFreq,   AHI_DEFAULT_FREQ,
+			AHIA_Channels,  1,
+			AHIA_Sounds,    2,
+			AHIA_SoundFunc, (IPTR)&self->soundhook,
+			TAG_DONE);
+		if(!self->actrl) {
+			AHI_ERR("AHI_AllocAudio for the Music unit failed\n");
+			return ALC_FALSE;
+		}
+		AHI_ControlAudio(self->actrl, AHIC_MixFreq_Query, (IPTR)&freq, TAG_DONE);
+		if(freq)
+			device->Frequency = freq;
+		self->mixfreq = device->Frequency;
+		self->ahi_fmt = get_ahi_music_format(device);
+	} else {
+		self->ahi_fmt = get_ahi_format(device);
+		if(self->ahi_fmt == -1)
+			return ALC_FALSE;
+	}
+
+	SetDefaultChannelOrder(device);
+
+	return ALC_TRUE;
+}
+
+static ALCboolean ALCplaybackAHI_start(ALCplaybackAHI *self) {
+	ALCdevice *device = STATIC_CAST(ALCbackend, self)->mDevice;
+
+	self->frames = device->UpdateSize;
+	self->data_size = self->frames * FrameSizeFromDevFmt(device->FmtChans, device->FmtType, device->AmbiOrder);
+
+	self->mix_data[0] = AllocVec(self->data_size, MEMF_PUBLIC | MEMF_CLEAR);
+	self->mix_data[1] = AllocVec(self->data_size, MEMF_PUBLIC | MEMF_CLEAR);
+
+	if(self->mix_data[0] != NULL && self->mix_data[1] != NULL) {
+		if(self->unit == AHI_MUSIC_UNIT) {
+			struct Library *AHIBase = self->ahibase;
+			int i;
+
+			if(!self->actrl)
+				goto fail;
+			for(i = 0; i < 2; i++) {
+				self->sample[i].ahisi_Type = self->ahi_fmt;
+				self->sample[i].ahisi_Address = self->mix_data[i];
+				self->sample[i].ahisi_Length = self->frames;
+				if(AHI_LoadSound(i, AHIST_DYNAMICSAMPLE, &self->sample[i], self->actrl) != AHIE_OK) {
+					if(i)
+						AHI_UnloadSound(0, self->actrl);
+					goto fail;
+				}
+			}
+			self->sounds_loaded = TRUE;
+		}
+		self->killNow = 0;
+		if(althrd_create(&self->thread, ALCplaybackAHI_mixerProc, self) == althrd_success)
+			return ALC_TRUE;
+		if(self->sounds_loaded) {
+			struct Library *AHIBase = self->ahibase;
+			AHI_UnloadSound(0, self->actrl);
+			AHI_UnloadSound(1, self->actrl);
+			self->sounds_loaded = FALSE;
+		}
+	}
+
+fail:
+	FreeVec(self->mix_data[1]);
+	FreeVec(self->mix_data[0]);
+	self->mix_data[0] = self->mix_data[1] = NULL;
+
+	return ALC_FALSE;
+}
+
+static void ALCplaybackAHI_stop(ALCplaybackAHI *self) {
+	int res;
+	struct Task *task;
+
+	if(self->killNow)
+		return;
+
+	self->killNow = 1;
+	/* the Music unit's thread sleeps between buffers: wake it */
+	if((task = self->mixtask) != NULL)
+		Signal(task, SIGBREAKF_CTRL_C);
+	althrd_join(self->thread, &res);
+
+	if(self->sounds_loaded) {
+		struct Library *AHIBase = self->ahibase;
+		AHI_UnloadSound(0, self->actrl);
+		AHI_UnloadSound(1, self->actrl);
+		self->sounds_loaded = FALSE;
+	}
+
+	FreeVec(self->mix_data[1]);
+	FreeVec(self->mix_data[0]);
+	self->mix_data[0] = self->mix_data[1] = NULL;
+}
+
+typedef struct ALCahiBackendFactory {
+	DERIVE_FROM_TYPE(ALCbackendFactory);
+} ALCahiBackendFactory;
+#define ALCAHIBACKENDFACTORY_INITIALIZER { { GET_VTABLE2(ALCahiBackendFactory, ALCbackendFactory) } }
+
+ALCbackendFactory *ALCahiBackendFactory_getFactory(void);
+
+static ALCboolean ALCahiBackendFactory_init(ALCahiBackendFactory *self);
+static void ALCahiBackendFactory_deinit(ALCahiBackendFactory*self);
+static ALCboolean ALCahiBackendFactory_querySupport(ALCahiBackendFactory *self, ALCbackend_Type type);
+static void ALCahiBackendFactory_probe(ALCahiBackendFactory *self, enum DevProbe type, al_string *outnames);
+static ALCbackend* ALCahiBackendFactory_createBackend(ALCahiBackendFactory *self, ALCdevice *device, ALCbackend_Type type);
+DEFINE_ALCBACKENDFACTORY_VTABLE(ALCahiBackendFactory);
+
+ALCbackendFactory *ALCahiBackendFactory_getFactory(void) {
+	static ALCahiBackendFactory factory = ALCAHIBACKENDFACTORY_INITIALIZER;
+	return STATIC_CAST(ALCbackendFactory, &factory);
+}
+
+ALCboolean ALCahiBackendFactory_init(ALCahiBackendFactory* UNUSED(self)) {
+	int unit;
+
+	ConfigValueStr(NULL, "ahi", "device", &ahi_driver);
+	if(ConfigValueInt(NULL, "ahi", "unit", &unit) && unit >= 0 && unit < AHI_UNIT_COUNT)
+		ahi_default_unit = unit;
+
+	return ALC_TRUE;
+}
+
+void ALCahiBackendFactory_deinit(ALCahiBackendFactory* UNUSED(self)) {
+}
+
+ALCboolean ALCahiBackendFactory_querySupport(ALCahiBackendFactory* UNUSED(self), ALCbackend_Type type) {
+	if(type == ALCbackend_Playback)
+		return ALC_TRUE;
+	return ALC_FALSE;
+}
+
+static void append_name(al_string *outnames, const ALCchar *name) {
+	alstr_append_range(outnames, name, name + strlen(name) + 1);
+}
+
+void ALCahiBackendFactory_probe(ALCahiBackendFactory* UNUSED(self), enum DevProbe type, al_string *outnames) {
+	int i;
+
+	switch(type) {
+		case ALL_DEVICE_PROBE:
+			append_name(outnames, ahi_device);
+			for(i = 0; i < AHI_UNIT_COUNT; i++)
+				append_name(outnames, ahi_unit_names[i]);
+			break;
+		case CAPTURE_DEVICE_PROBE:
+			break;
+	}
+}
+
+ALCbackend* ALCahiBackendFactory_createBackend(ALCahiBackendFactory* UNUSED(self), ALCdevice *device, ALCbackend_Type type) {
+	if(type == ALCbackend_Playback) {
+		ALCplaybackAHI *backend;
+
+		backend = ALCplaybackAHI_New(sizeof(*backend));
+		if(!backend) return NULL;
+		memset(backend, 0, sizeof(*backend));
+
+		ALCplaybackAHI_Construct(backend, device);
+
+		return STATIC_CAST(ALCbackend, backend);
+	}
+
+	return NULL;
+}
