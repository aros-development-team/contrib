diff -ruN ffmpeg-8.1.2/configure ffmpeg-8.1.2.aros/configure
--- ffmpeg-8.1.2/configure	2026-06-17 03:17:51.000000000 +0100
+++ ffmpeg-8.1.2.aros/configure	2026-10-27 18:30:29.769859522 +0000
@@ -2564,6 +2564,7 @@
 
 SYSTEM_LIBRARIES="
     bcrypt
+    vaapi_aros
     vaapi_drm
     vaapi_x11
     vaapi_win32
@@ -6041,6 +6042,8 @@
         SLIB_INSTALL_LINKS=
         SHFLAGS='-shared -Wl,-soname,$(SLIBNAME)'
         ;;
+    aros)
+        ;;
     haiku)
         prefix_default="/boot/common"
         network_extralibs="-lnetwork"
@@ -7664,14 +7667,22 @@
 enabled libdrm &&
     check_pkg_config libdrm_getfb2 libdrm "xf86drmMode.h" drmModeGetFB2
 
-enabled vaapi &&
+if enabled vaapi && test "$target_os" = aros; then
+    # libva is a static link library with its built-in driver, no pkg-config
+    check_lib vaapi "va/va.h" vaInitialize -lva -lsurfacetrack -lpthread
+elif enabled vaapi; then
     check_pkg_config vaapi "libva >= 0.35.0" "va/va.h" vaInitialize
+fi
 
 if enabled vaapi; then
     case $target_os in
         mingw32*|mingw64*|win32|win64)
             check_pkg_config vaapi_win32 "libva-win32" "va/va_win32.h" vaGetDisplayWin32
             ;;
+        aros)
+            check_func_headers "va/va.h va/va_aros.h" vaGetDisplayAROS -lva -lsurfacetrack -lpthread &&
+                enable vaapi_aros
+            ;;
         *)
             check_pkg_config vaapi_drm "libva-drm" "va/va_drm.h" vaGetDisplayDRM
             ;;
