include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-multimedia : development-flac
#MM development-flac : development-libogg

FLAC_VERSION=1.5.0

# AROS has no __stack_chk_fail/__stack_chk_guard, so the stack protector
# that flac enables by default cannot be linked.
EXTRAOPTS := --disable-doxygen-docs --disable-xmms-plugin --disable-valgrind-testing --disable-exhaustive-tests --disable-thorough-tests --disable-stack-smash-protection 

USER_CPPFLAGS := -D_GNU_SOURCE
USER_LDFLAGS := -static-libstdc++

REPOSITORIES := http://downloads.xiph.org/releases/flac \
 https://ftp.osuosl.org/pub/xiph/releases/flac \
 http://mirror.sobukus.de/files/grimoire/audio-libs \
 https://download.videolan.org/videolan/testing/contrib/flac \
 http://meanwhile.dreamhost.com/pub/blfs/conglomeration/flac

%fetch_and_build_gnu_development package=flac version=$(FLAC_VERSION) patch=yes \
    package_repo="$(REPOSITORIES)" suffixes="tar.xz" \
    extraoptions=$(EXTRAOPTS) nlsflag=no xflag=no
