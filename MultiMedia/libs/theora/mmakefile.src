include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-multimedia : development-libtheora

#MM- development-libtheora : development-libogg development-libvorbis

LIBTHEORA_VERSION=1.2.0

REPOSITORIES := http://downloads.xiph.org/releases/theora \
 https://ftp.osuosl.org/pub/xiph/releases/theora \
 http://dlc-origin.openindiana.org/oi/jds/downloads/sources \
 http://www.slackware.com/~alien/slackbuilds/vlc/build/sources

LIBTHEORA_CONFIG_OPTIONS := --disable-examples --libdir=$(AROS_LIB)

# The hand-written ARM assembly paths have no run-time CPU detection method for
# AROS (lib/arm/armcpu.c falls through to an #error), so disable the asm on ARM
# targets until proper AROS support is implemented.
ifneq (,$(findstring arm,$(AROS_TARGET_CPU)))
LIBTHEORA_CONFIG_OPTIONS += --disable-asm
endif

%fetch_and_build_gnu_development package=libtheora version=$(LIBTHEORA_VERSION) patch=yes \
    package_repo="$(REPOSITORIES)" suffixes="tar.gz" \
    extraoptions="$(LIBTHEORA_CONFIG_OPTIONS)" nlsflag=no xflag=no \
    config_env_extra="V=1 PKG_CONFIG=$(TOOLDIR)/$(AROS_TARGET_CPU)-aros-pkg-config" use_build_env=yes

