include $(SRCDIR)/config/aros-contrib.cfg

#MM- contrib-multimedia : development-libmikmod

MIKMODVERSION=3.3.14
REPOSITORIES := http://distcache.freebsd.org/ports-distfiles \
https://ftp.openbsd.org/pub/OpenBSD/distfiles \
http://prdownloads.sourceforge.net/mikmod/libmikmod/$(MIKMODVERSION)
ARCHNAME     := libmikmod
ARCHBASE     := $(ARCHNAME)-$(MIKMODVERSION)
ARCHSUFFIX   := "tar.gz"

%fetch_and_build_gnu_development package=libmikmod version=$(MIKMODVERSION) patch=no \
    package_repo=$(REPOSITORIES) suffixes=$(ARCHSUFFIX) nlsflag=no
