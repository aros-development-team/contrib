# Have a look at doc/PATENTS

include $(SRCDIR)/config/aros-contrib.cfg

###################################################################################
# Static link library version of libfaad (faad2), used by e.g. the aac.datatype.

FAAD_LIBFILES := \
    bits \
    cfft \
    common \
    decoder \
    drc \
    drm_dec \
    error \
    filtbank \
    hcr \
    huffman \
    ic_predict \
    is \
    lt_predict \
    mdct \
    mp4 \
    ms \
    output \
    pns \
    ps_dec \
    ps_syntax \
    pulse \
    rvlc \
    sbr_dct \
    sbr_dec \
    sbr_e_nf \
    sbr_fbt \
    sbr_hfadj \
    sbr_hfgen \
    sbr_huff \
    sbr_qmf \
    sbr_syntax \
    sbr_tf_grid \
    specrec \
    ssr \
    ssr_fb \
    ssr_ipqf \
    syntax \
    tns

NOWARN_FLAGS := $(NOWARN_CPP)

USER_CFLAGS   := -DHAVE_CONFIG_H $(NOWARN_FLAGS)
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)

#MM- linklibs : linklibs-faad
#MM linklibs-faad : includes

%build_linklib mmake=linklibs-faad libname=faad \
    files="$(FAAD_LIBFILES)" \
    objdir=$(OBJDIR)/linklib

INCLUDE_FILES := neaacdec.h faad.h
%copy_includes mmake=includes-copy

###################################################################################
# Static link library version of mp4ff (faad2's MP4/M4A demuxer), used
# together with libfaad to play AAC audio from MP4 containers.

MP4FF_LIBFILES := \
    mp4ff/mp4ff \
    mp4ff/mp4atom \
    mp4ff/mp4meta \
    mp4ff/mp4sample \
    mp4ff/mp4tagupdate \
    mp4ff/mp4util

# mp4ff must not see HAVE_CONFIG_H - its "../../config.h" include does
# not resolve in the vendored layout; HAVE_STDINT_H is all it needs.
USER_CFLAGS   := -DHAVE_STDINT_H -DUSE_TAGGING $(NOWARN_FLAGS)
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/mp4ff

#MM- linklibs : linklibs-mp4ff
#MM linklibs-mp4ff : includes

%build_linklib mmake=linklibs-mp4ff libname=mp4ff \
    files="$(MP4FF_LIBFILES)" \
    objdir=$(OBJDIR)/linklib-mp4ff

INCLUDE_FILES := mp4ff.h mp4ff_int_types.h
%copy_includes mmake=includes-copy dir=mp4ff

%common
