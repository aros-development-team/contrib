#MM- contrib-sdl3 : SDL3-aros
#MM- SDL3-aros-lib : SDL3-aros-sharedlib-linklib
#MM- SDL3-aros : SDL3-aros-sharedlib SDL3-aros-genfiles SDL3-aros-tests
#MM- SDL3-aros-tests : SDL3-aros-tests-main SDL3-aros-tests-utils SDL3-aros-tests-aut SDL3-aros-tests-copyfiles
#MM SDL3-aros-tests-main : includes linklibs contrib-sdl3-fetch development-sdl3 SDL3-aros-test-commonlib
#MM SDL3-aros-tests-utils : includes linklibs contrib-sdl3-fetch development-sdl3 SDL3-aros-test-commonlib SDL3-aros-test-utillib
#MM SDL3-aros-tests-aut : includes linklibs contrib-sdl3-fetch development-sdl3 SDL3-aros-test-commonlib

# Special target
#MM- development-sdl3 : SDL3-aros-copy-includes SDL3-aros-genfiles SDL3-aros-sharedlib-includes SDL3-aros-sharedlib-linklib

#MM SDL3-aros-sharedlib : includes linklibs  contrib-sdl3-fetch SDL3-aros-copy-includes workbench-devs-AHI workbench-libs-mesa-linklib \
#MM  development-libiconv

#MM SDL3-aros-staticlib : includes linklibs  contrib-sdl3-fetch SDL3-aros-copy-includes workbench-devs-AHI

REPOSITORIES := http://www.libsdl.org/release/
ARCHVER      := 3.4.12
ARCHBASE     := SDL3-$(ARCHVER)

ARCHSRCDIR := $(PORTSDIR)/SDL3/$(ARCHBASE)
TESTEXEDIR := $(AROS_TESTS)/SDL3

%fetch mmake=contrib-sdl3-fetch archive=$(ARCHBASE) suffixes="tar.gz" \
    location=$(PORTSSOURCEDIR) destination=$(PORTSDIR)/SDL3 \
    archive_origins=". $(REPOSITORIES)" \
    patches_specs=$(ARCHBASE)-aros.diff:$(ARCHBASE):-p1

%create_patch mmake=contrib-sdl3-create-patch archive=$(ARCHBASE) \
    suffixes="tar.gz" destination=$(PORTSDIR)/SDL3

