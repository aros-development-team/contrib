SDL3INCDIR := $(AROS_INCLUDES)/SDL3

NOWARN_FLAGS := $(NOWARN_STRINGOP_TRUNCATION)
USER_CFLAGS := $(CFLAGS_GNU99) $(NOWARN_FLAGS)

USER_INCLUDES := -I$(ARCHSRCDIR)/include -I$(ARCHSRCDIR)/include/build_config -I$(ARCHSRCDIR) -I$(ARCHSRCDIR)/src -I$(AROS_CONTRIB_INCLUDES)
USER_LDFLAGS := -L$(AROS_CONTRIB_LIB)
USER_CPPFLAGS := \
        -DADATE="\"$(shell date '+%d.%m.%Y')\""

# The following objects are compiled directly into the SDL3 link library so
# that they run inside the application rather than behind the library jump
# table. This is required for every function that produces or consumes a
# va_list (SDL_Log*, SDL_*printf, SDL_SetError* and their "V" variants): a
# va_list cannot be marshalled across an AROS LVO stub, so these must be
# called directly. SDL_log.c additionally needs the local stdio context for
# its console output. SDL_error.c needs SDL_GetErrBuf(), supplied locally by
# SDL3_errbuf.c (SDL3 keeps it in SDL_thread.c, which would drag in the whole
# thread backend). SDL3_varargs.c supplies the few remaining variadic entry
# points that those objects do not.
SDL3_LOGSTUB=$(GENDIR)/$(CURDIR)/SDL3/linklib/SDL_liblog.o
$(SDL3_LOGSTUB): $(ARCHSRCDIR)/src/SDL_log.c
	%compile_q cmd="$(strip $(TARGET_CC) $(TARGET_SYSROOT))" opt="$(strip $(CFLAGS) $(CPPFLAGS) -I$(ARCHSRCDIR)/include -I$(ARCHSRCDIR)/include/build_config -I$(ARCHSRCDIR)/src)" iquote="$(CFLAGS_IQUOTE)" iquote_end="$(CFLAGS_IQUOTE_END)"

SDL3_STRINGSTUB=$(GENDIR)/$(CURDIR)/SDL3/linklib/SDL_libstring.o
$(SDL3_STRINGSTUB): $(ARCHSRCDIR)/src/stdlib/SDL_string.c
	%compile_q cmd="$(strip $(TARGET_CC) $(TARGET_SYSROOT))" opt="$(strip $(CFLAGS) $(CPPFLAGS) -I$(ARCHSRCDIR)/include -I$(ARCHSRCDIR)/include/build_config -I$(ARCHSRCDIR)/src)" iquote="$(CFLAGS_IQUOTE)" iquote_end="$(CFLAGS_IQUOTE_END)"

SDL3_ERRORSTUB=$(GENDIR)/$(CURDIR)/SDL3/linklib/SDL_liberror.o
$(SDL3_ERRORSTUB): $(ARCHSRCDIR)/src/SDL_error.c
	%compile_q cmd="$(strip $(TARGET_CC) $(TARGET_SYSROOT))" opt="$(strip $(CFLAGS) $(CPPFLAGS) -I$(ARCHSRCDIR)/include -I$(ARCHSRCDIR)/include/build_config -I$(ARCHSRCDIR)/src)" iquote="$(CFLAGS_IQUOTE)" iquote_end="$(CFLAGS_IQUOTE_END)"

SDL3_ERRBUFSTUB=$(GENDIR)/$(CURDIR)/SDL3/linklib/SDL3_errbuf.o
$(SDL3_ERRBUFSTUB): $(SRCDIR)/$(CURDIR)/SDL3_errbuf.c
	%compile_q cmd="$(strip $(TARGET_CC) $(TARGET_SYSROOT))" opt="$(strip $(CFLAGS) $(CPPFLAGS) -I$(ARCHSRCDIR)/include -I$(ARCHSRCDIR)/include/build_config -I$(ARCHSRCDIR)/src)" iquote="$(CFLAGS_IQUOTE)" iquote_end="$(CFLAGS_IQUOTE_END)"

SDL3_VARARGSSTUB=$(GENDIR)/$(CURDIR)/SDL3/linklib/SDL3_varargs.o
$(SDL3_VARARGSSTUB): $(SRCDIR)/$(CURDIR)/SDL3_varargs.c
	%compile_q cmd="$(strip $(TARGET_CC) $(TARGET_SYSROOT))" opt="$(strip $(CFLAGS) $(CPPFLAGS) -I$(ARCHSRCDIR)/include -I$(ARCHSRCDIR)/include/build_config -I$(ARCHSRCDIR)/src)" iquote="$(CFLAGS_IQUOTE)" iquote_end="$(CFLAGS_IQUOTE_END)"

SDL3LINKLIBOBJS := \
    $(SDL3_LOGSTUB) \
    $(SDL3_STRINGSTUB) \
    $(SDL3_ERRORSTUB) \
    $(SDL3_ERRBUFSTUB) \
    $(SDL3_VARARGSSTUB)

USER_CPPFLAGS := \
        -DSDL3_AROS_SHARED \
        -DADATE="\"$(shell date '+%d.%m.%Y')\""

%build_module mmake=SDL3-aros-sharedlib \
    modname=SDL3 modtype=library \
    files="SDL3_library $(FILES)" \
    linklibobjs="$(SDL3LINKLIBOBJS)" \
    conffile=SDL3.conf \
    uselibs="iconv GL"

USER_CPPFLAGS := \
        -DSDL3_AROS_STATIC \
        -DADATE="\"$(shell date '+%d.%m.%Y')\""

%build_linklib mmake=SDL3-aros-staticlib libname=SDL3_static \
    files="SDL3_static $(FILES)"

%copy_dir_recursive mmake=SDL3-aros-copy-includes \
    src=$(ARCHSRCDIR)/include/SDL3/. dst="$(SDL3INCDIR)"

$(AROS_DEVELOPER)/bin:
	%mkdir_q dir=$@

$(AROS_DEVELOPER)/bin/sdl3-config: $(SRCDIR)/$(CURDIR)/sdl3-config | $(AROS_DEVELOPER)/bin
	$(Q)$(ECHO) Generating sdl3-config ...
	$(Q)$(CP) $< $@
	$(Q)$(CHMOD) a+x $@

$(AROS_LIB)/pkgconfig:
	%mkdir_q dir=$@

$(AROS_LIB)/pkgconfig/sdl3.pc: $(ARCHSRCDIR)/cmake/sdl3.pc.in | $(AROS_LIB)/pkgconfig
	$(Q)$(ECHO) Generating pkgconfig/sdl3.pc ...
	$(Q)$(SED) \
		-e 's#@SDL_PKGCONFIG_PREFIX@#$(AROS_DEVELOPER)#g' \
		-e 's#@LIBDIR_FOR_PKG_CONFIG@#$${prefix}/lib#g' \
		-e 's#@INCLUDEDIR_FOR_PKG_CONFIG@#$${prefix}/include#g' \
		-e 's#@PROJECT_VERSION@#$(ARCHVER)#g' \
		-e 's#@SDL_PC_PRIVATE_REQUIRES@##g' \
		-e 's#@SDL_RLD_FLAGS@##g' \
		-e 's#@SDL_PC_LIBS@#-lSDL3#g' \
		-e 's#@SDL_PC_SECTION_LIBS_PRIVATE@##g' \
		-e 's#@SDL_PC_STATIC_LIBS@#-lGL -liconv#g' \
		-e 's#@SDL_PC_CFLAGS@#-D_GNU_SOURCE=1#g' \
		$< > $@
	$(Q)$(CHMOD) a+x $@

#MM
SDL3-aros-genfiles : $(AROS_DEVELOPER)/bin/sdl3-config $(AROS_LIB)/pkgconfig/sdl3.pc
	$(Q)$(NOP)

#MM SDL3-aros-copy-includes : contrib-sdl3-fetch

