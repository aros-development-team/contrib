+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+// A counting semaphore implemented with AROS signal semaphores and the
+// timer.device for timed waits.
+
+#include "SDL_systhread_c.h"
+
+#include <devices/timer.h>
+#include <dos/dos.h>
+#include <exec/execbase.h>
+#include <exec/lists.h>
+#include <proto/exec.h>
+
+struct waitnode
+{
+    struct Message msg;
+    struct MsgPort port;
+};
+
+struct SDL_Semaphore
+{
+    Uint32 sem_value;
+    struct MinList waitlist;
+    struct SignalSemaphore sem;
+};
+
+extern void InitQPort(struct MsgPort *port);
+extern struct timerequest GlobalTimeReq;
+
+static void mywaitinit(struct timerequest *r, struct waitnode *wn)
+{
+    r->tr_node.io_Message.mn_Node.ln_Type = NT_REPLYMSG;
+    r->tr_node.io_Message.mn_ReplyPort    = &wn->port;
+    r->tr_node.io_Device                  = GlobalTimeReq.tr_node.io_Device;
+    r->tr_node.io_Unit                    = GlobalTimeReq.tr_node.io_Unit;
+}
+
+SDL_Semaphore *SDL_CreateSemaphore(Uint32 initial_value)
+{
+    SDL_Semaphore *sem;
+
+    sem = (SDL_Semaphore *)SDL_malloc(sizeof(*sem));
+    if (!sem) {
+        return NULL;
+    }
+
+    sem->sem_value = initial_value;
+
+    NEWLIST((struct List *)&sem->waitlist);
+    SDL_memset(&sem->sem, 0, sizeof(sem->sem));
+    InitSemaphore(&sem->sem);
+
+    return sem;
+}
+
+/* WARNING:
+   You cannot call this function when another thread is using the semaphore.
+*/
+void SDL_DestroySemaphore(SDL_Semaphore *sem)
+{
+    if (sem) {
+        ObtainSemaphore(&sem->sem);
+
+        sem->sem_value = (Uint32)-1;
+
+        while (!IsListEmpty((struct List *)&sem->waitlist)) {
+            struct waitnode *wn;
+
+            for (wn = (struct waitnode *)sem->waitlist.mlh_Head; wn->msg.mn_Node.ln_Succ; wn = (struct waitnode *)wn->msg.mn_Node.ln_Succ)
+                ReplyMsg(&wn->msg);
+
+            if (!SDL_WaitSemaphoreTimeoutNS(sem, 10 * SDL_NS_PER_MS))
+                break;
+        }
+
+        ReleaseSemaphore(&sem->sem);
+
+        SDL_free(sem);
+    }
+}
+
+bool SDL_WaitSemaphoreTimeoutNS(SDL_Semaphore *sem, Sint64 timeoutNS)
+{
+    bool acquired = false;
+    struct waitnode wn;
+
+    if (!sem) {
+        return true;
+    }
+
+    // Try the semaphore, and enqueue a wait node if we need to block.
+    ObtainSemaphore(&sem->sem);
+
+    if (sem->sem_value > 0) {
+        --sem->sem_value;
+        acquired = true;
+    } else if (timeoutNS != 0) {
+        InitQPort(&wn.port);
+        wn.msg.mn_Node.ln_Type = NT_MESSAGE;
+        wn.msg.mn_ReplyPort = &wn.port;
+        ADDTAIL((struct List *)&sem->waitlist, (struct Node *)&wn);
+    }
+
+    ReleaseSemaphore(&sem->sem);
+
+    if (acquired || timeoutNS == 0) {
+        return acquired;
+    }
+
+    if (timeoutNS < 0) {
+        // Infinite wait: block until a post replies our message.
+        WaitPort(&wn.port);
+        acquired = true;
+    } else {
+        struct timerequest req;
+        struct Message *msg;
+
+        mywaitinit(&req, &wn);
+
+        req.tr_node.io_Command = TR_ADDREQUEST;
+        req.tr_time.tv_secs  = timeoutNS / 1000000000LL;
+        req.tr_time.tv_micro = (timeoutNS / 1000) % 1000000;
+        SendIO((struct IORequest *)&req);
+
+        msg = WaitPort(&wn.port);
+        acquired = true;
+
+        if (msg != &wn.msg) {
+            ObtainSemaphore(&sem->sem);
+            REMOVE((struct Node *)&wn);
+            acquired = (wn.msg.mn_Node.ln_Type == NT_REPLYMSG);
+            ReleaseSemaphore(&sem->sem);
+        }
+
+        AbortIO((struct IORequest *)&req);
+        WaitIO((struct IORequest *)&req);
+    }
+
+    return acquired;
+}
+
+Uint32 SDL_GetSemaphoreValue(SDL_Semaphore *sem)
+{
+    if (!sem) {
+        return 0;
+    }
+
+    return sem->sem_value;
+}
+
+void SDL_SignalSemaphore(SDL_Semaphore *sem)
+{
+    struct waitnode *wn;
+
+    if (!sem) {
+        return;
+    }
+
+    ObtainSemaphore(&sem->sem);
+
+    sem->sem_value++;
+
+    // Wake whatever task happens to be first in the waitlist.
+    if ((wn = (struct waitnode *)REMHEAD((struct List *)&sem->waitlist))) {
+        sem->sem_value--;
+        ReplyMsg(&wn->msg);
+    }
+
+    ReleaseSemaphore(&sem->sem);
+}
+
+/* vi: set ts=4 sw=4 expandtab: */
