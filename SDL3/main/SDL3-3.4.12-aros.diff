+extern struct DosLibrary *DOSBase;
+extern struct ExecBase *SysBase;
+
+/* Return an SDL_malloc()'d copy of the full name behind an AROS lock, with a
+   trailing path separator appended where appropriate (so callers can simply
+   concatenate a file name). */
+static char *AROS_NameFromLock(BPTR lock, bool add_separator)
+{
+    char *path = NULL;
+    size_t len = 128;
+
+    if (!lock) {
+        return NULL;
+    }
+
+    for (;;) {
+        char *tmp = (char *)SDL_malloc(len + 2);
+        if (!tmp) {
+            return NULL;
+        }
+
+        if (NameFromLock(lock, tmp, len)) {
+            size_t l = SDL_strlen(tmp);
+            if (add_separator && l > 0 && tmp[l - 1] != ':' && tmp[l - 1] != '/') {
+                tmp[l++] = '/';
+                tmp[l] = '\0';
+            }
+            path = tmp;
+            break;
+        }
+
+        SDL_free(tmp);
+
+        if (IoErr() != ERROR_LINE_TOO_LONG) {
+            break;
+        }
+        len *= 2;
+    }
+
+    return path;
+}
+
+char *SDL_SYS_GetBasePath(void)
+{
+    BPTR lock = Lock("PROGDIR:", SHARED_LOCK);
+    char *path = AROS_NameFromLock(lock, true);
+
+    if (lock) {
+        UnLock(lock);
+    }
+
+    if (!path) {
+        SDL_SetError("Couldn't determine PROGDIR:");
+    }
+    return path;
+}
+
+char *SDL_SYS_GetExeName(void)
+{
+    BPTR lock = Lock("PROGDIR:", SHARED_LOCK);
+    char *dir = AROS_NameFromLock(lock, false);
+    char *path = NULL;
+
+    if (lock) {
+        UnLock(lock);
+    }
+
+    if (dir) {
+        char namebuf[256];
+        namebuf[0] = '\0';
+        if (GetProgramName(namebuf, sizeof(namebuf))) {
+            const char *fname = FilePart(namebuf);
+            size_t len = SDL_strlen(dir) + 1 + SDL_strlen(fname) + 1;
+            path = (char *)SDL_malloc(len);
+            if (path) {
+                SDL_strlcpy(path, dir, len);
+                AddPart(path, (STRPTR)fname, len);
+            }
+        }
+        SDL_free(dir);
+    }
+
+    return path;
+}
+
+static char *AROS_RemoveInvalidChars(const char *src)
+{
+    char *s = src ? SDL_strdup(src) : NULL;
+
+    if (s) {
+        char *r = s;
+        char *w = s;
+        char c;
+        while ((c = *r++) != '\0') {
+            if (c != '/' && c != ':') {
+                *w++ = c;
+            }
+        }
+        *w = '\0';
+    }
+    return s;
+}
+
+char *SDL_SYS_GetPrefPath(const char *org, const char *app)
+{
+    char *p1 = AROS_RemoveInvalidChars(org);
+    char *p2 = AROS_RemoveInvalidChars(app);
+    char *path = NULL;
+    size_t len = sizeof("ENVARC:") + 2;
+
+    if (p1) {
+        len += SDL_strlen(p1) + 1;
+    }
+    if (p2) {
+        len += SDL_strlen(p2) + 1;
+    }
+
+    path = (char *)SDL_malloc(len);
+    if (path) {
+        BPTR lock;
+        SDL_strlcpy(path, "ENVARC:", len);
+
+        if (p1 && *p1) {
+            AddPart(path, (STRPTR)p1, len);
+            if ((lock = CreateDir(path))) {
+                UnLock(lock);
+            }
+        }
+        if (p2 && *p2) {
+            AddPart(path, (STRPTR)p2, len);
+            if ((lock = CreateDir(path))) {
+                UnLock(lock);
+            }
+        }
+
+        /* SDL_GetPrefPath() is documented to end with a path separator. */
+        size_t l = SDL_strlen(path);
+        if (l > 0 && path[l - 1] != ':' && path[l - 1] != '/') {
+            path[l++] = '/';
+            path[l] = '\0';
+        }
+    } else {
+        SDL_OutOfMemory();
+    }
+
+    SDL_free(p2);
+    SDL_free(p1);
+
+    return path;
+}
+
+char *SDL_SYS_GetUserFolder(SDL_Folder folder)
+{
+    /* AROS has no standard XDG-style user folders; expose the system volume
+       as a usable location for HOME and report the rest as unsupported. */
+    switch (folder) {
+    case SDL_FOLDER_HOME:
+        return SDL_strdup("SYS:");
+    default:
+        SDL_SetError("Unsupported AROS user folder");
+        return NULL;
+    }
+}
+
+char *SDL_SYS_GetCurrentDirectory(void)
+{
+    struct Process *proc = (struct Process *)FindTask(NULL);
+    char *path = AROS_NameFromLock(proc->pr_CurrentDir, true);
+
+    if (!path) {
+        SDL_SetError("Couldn't determine the current directory");
+    }
+    return path;
+}
+
+#endif /* SDL_FILESYSTEM_AROS */
