diff -ruN --strip-trailing-cr SDL3-3.4.12/src/audio/ahi/SDL_ahi_audio.c SDL3-3.4.12.aros/src/audio/ahi/SDL_ahi_audio.c
--- SDL3-3.4.12/src/audio/ahi/SDL_ahi_audio.c	1970-01-01 01:00:00.000000000 +0100
+++ SDL3-3.4.12.aros/src/audio/ahi/SDL_ahi_audio.c	2026-07-28 13:08:21.755632791 +0100
@@ -0,0 +1,484 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
