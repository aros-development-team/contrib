+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+//#define DEBUG 1
+#include <aros/debug.h>
+
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_AHI
+
+#include "../SDL_sysaudio.h"
+#include "SDL_ahi_audio.h"
+
+#include <sys/param.h>
+#include <string.h>
+
+#include <dos/dos.h>
+#include <exec/execbase.h>
+#include <proto/ahi.h>
+#include <proto/exec.h>
+
+#define RESTART_CAPTURE_THRESHOLD 500
+
+typedef struct {
+    char *id_Name;
+    IPTR  id_ModeID;
+    IPTR  id_ConnectionID;
+    IPTR  id_FreqIdx;
+    IPTR  id_Freq;
+} AHI_SDLIntDevice;
+
+static Fixed            AHI_Volume = 0x10000;
+static const char       AHI_SDL_DEVICE_FMT[] = "%s AHI %s device <%s>";
+static AHI_SDLIntDevice *AHI_SDLInputDefault = NULL;
+static AHI_SDLIntDevice *AHI_SDLOutputDefault = NULL;
+
+void AHI_Mute(ULONG mute)
+{
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+    AHI_Volume = mute ? 0 : 0x10000;
+}
+
+SDL_AudioFormat AHI_GenerateSDLFormat(ULONG bits)
+{
+    SDL_AudioFormat usefmt;
+    switch (bits) {
+    case 32:
+#if SDL_BYTEORDER == SDL_BIG_ENDIAN
+        usefmt = SDL_AUDIO_S32BE;
+#else
+        usefmt = SDL_AUDIO_S32LE;
+#endif
+        break;
+    case 8:
+        usefmt = SDL_AUDIO_S8;
+        break;
+    default:
+#if SDL_BYTEORDER == SDL_BIG_ENDIAN
+        usefmt = SDL_AUDIO_S16BE;
+#else
+        usefmt = SDL_AUDIO_S16LE;
+#endif
+        break;
+    }
+    return usefmt;
+}
+
+static void AHI_GenerateSDLDeviceSpecs(APTR _Base, char *devbase, BOOL isinput, int modedef, int modeid, int conmax, int freqmax, IPTR freqdef, SDL_AudioDevice **defaultdev)
+{
+    struct AHIBase *AHIBase = (struct AHIBase *)_Base;
+    char *modetype = (isinput) ? "Input" : "Output";
+    int current;
+    for (current = 0; current < conmax; current++) {
+        UBYTE desc[80];
+        IPTR stereo = 0, bits = 0, multi = 0;
+        struct TagItem conTags[] = {
+            { AHIDB_BufferLen,     80              },
+            { TAG_IGNORE,          current         },
+            { TAG_IGNORE,          (IPTR)&desc     },
+            { AHIDB_Stereo,        (IPTR)&stereo   },
+            { AHIDB_MultiChannel,  (IPTR)&multi    },
+            { AHIDB_Bits,          (IPTR)&bits     },
+            { TAG_DONE,            0               }
+        };
+        SDL_AudioSpec devspec;
+        char *sdlDevName;
+        int freq, modetype_len;
+        desc[0] = '\0';
+        if (isinput) {
+            conTags[1].ti_Tag = AHIDB_InputArg;
+            conTags[2].ti_Tag = AHIDB_Input;
+            modetype_len = 5;
+        } else {
+            conTags[1].ti_Tag = AHIDB_OutputArg;
+            conTags[2].ti_Tag = AHIDB_Output;
+            modetype_len = 6;
+        }
+        AHI_GetAudioAttrsA(modeid, NULL, conTags);
+        SDL_zero(devspec);
+        devspec.channels = 1;
+        if (stereo) {
+            devspec.channels += 1;
+            if (multi)
+                devspec.channels += 6; // 7.1 = 8 channels.
+        }
+        sdlDevName = AllocVec(strlen(devbase) + modetype_len + 12 + strlen(desc) + 3 + 1, MEMF_PUBLIC);
+        sprintf(sdlDevName, AHI_SDL_DEVICE_FMT, devbase, modetype, desc);
+        devspec.format = AHI_GenerateSDLFormat(bits);
+        for (freq = 0; freq < freqmax; freq++) {
+            AHI_SDLIntDevice *sdlDevPrivate = (AHI_SDLIntDevice *)AllocVec(sizeof(AHI_SDLIntDevice) + strlen(sdlDevName) + 1, MEMF_ANY);
+            IPTR curfreq = 0;
+            sdlDevPrivate->id_Name = (char *)((IPTR)sdlDevPrivate + sizeof(AHI_SDLIntDevice));
+            AHI_GetAudioAttrs(modeid, NULL,
+                AHIDB_FrequencyArg, freq,
+                AHIDB_Frequency,    (IPTR)&curfreq,
+                TAG_DONE);
+            devspec.freq = curfreq;
+            sprintf(sdlDevPrivate->id_Name, "%s", sdlDevName);
+            sdlDevPrivate->id_ModeID = modeid;
+            sdlDevPrivate->id_ConnectionID = current;
+            sdlDevPrivate->id_FreqIdx = freq;
+            sdlDevPrivate->id_Freq = curfreq;
+            D(bug("[SDL3:AHI] %s: %s '%s' @ %uhz\n", __func__, modetype, desc, (unsigned)curfreq));
+            SDL_AudioDevice *added = SDL_AddAudioDevice((isinput) ? true : false,
+                sdlDevPrivate->id_Name, &devspec, sdlDevPrivate);
+            if ((modedef == modeid) && (curfreq == freqdef)) {
+                if (isinput)
+                    AHI_SDLInputDefault = sdlDevPrivate;
+                else
+                    AHI_SDLOutputDefault = sdlDevPrivate;
+                if (defaultdev && added)
+                    *defaultdev = added;
+            }
+        }
+        FreeVec(sdlDevName);
+    }
+}
+
+static void AHI_FreeHandle(SDL_AudioDevice *device)
+{
+    D(bug("[SDL3:AHI] %s(0x%p)\n", __func__, device->handle));
+    if (device->handle)
+        FreeVec(device->handle);
+}
+
+static void AHI_DetectDevices(SDL_AudioDevice **default_playback, SDL_AudioDevice **default_recording)
+{
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    struct MsgPort *ahiPort = CreateMsgPort();
+    if (ahiPort) {
+        struct AHIRequest *ahiReq = (struct AHIRequest *)CreateIORequest(ahiPort, sizeof(struct AHIRequest));
+        if (ahiReq) {
+            ahiReq->ahir_Version = 1;
+            if (OpenDevice(AHINAME, AHI_NO_UNIT, (struct IORequest *)ahiReq, 0) == 0) {
+                ULONG id = AHI_INVALID_ID;
+                IPTR deffreq = 0, defid = 0;
+                struct AHIBase *AHIBase = (struct AHIBase *)ahiReq->ahir_Std.io_Device;
+                AHI_GetAudioAttrs(AHI_DEFAULT_ID, NULL,
+                    AHIDB_Frequency, (IPTR)&deffreq,
+                    AHIDB_AudioID,   (IPTR)&defid,
+                    TAG_DONE);
+                D(bug("[SDL3:AHI] %s: Default %u freq %u\n", __func__, (unsigned)defid, (unsigned)deffreq));
+                while ((id = AHI_NextAudioID(id)) != AHI_INVALID_ID) {
+                    UBYTE name[80];
+                    IPTR freqs = 0, minmix = 0, maxmix = 0, flags = 0, record = 0, inputs = 0, outputs = 0;
+                    name[0] = '\0';
+                    AHI_GetAudioAttrs(id, NULL,
+                        AHIDB_BufferLen,    80,
+                        AHIDB_Name,         (IPTR)&name,
+                        AHIDB_Frequencies,  (IPTR)&freqs,
+                        AHIDB_MinMixFreq,   (IPTR)&minmix,
+                        AHIDB_MaxMixFreq,   (IPTR)&maxmix,
+                        AHIDB_Record,       (IPTR)&record,
+                        AHIDB_Inputs,       (IPTR)&inputs,
+                        AHIDB_Outputs,      (IPTR)&outputs,
+                        AHIDB_Flags,        (IPTR)&flags,
+                        TAG_DONE);
+                    D(bug("[SDL3:AHI] %s: Mode ID %u '%s', %u frequencies\n", __func__, (unsigned)id, name, (unsigned)freqs));
+                    char *colon = strchr(name, ':');
+                    if (colon)
+                        *colon = 0;
+                    if (outputs > 0)
+                        AHI_GenerateSDLDeviceSpecs(AHIBase, name, FALSE, defid, id, outputs, freqs, deffreq, default_playback);
+                    if ((record) && (inputs > 0))
+                        AHI_GenerateSDLDeviceSpecs(AHIBase, name, TRUE, defid, id, inputs, freqs, deffreq, default_recording);
+                }
+                CloseDevice((struct IORequest *)ahiReq);
+            }
+            DeleteIORequest(ahiReq);
+        }
+        DeleteMsgPort(ahiPort);
+    }
+}
+
+static bool AHI_WaitDevice(SDL_AudioDevice *device)
+{
+    AHIAudioData *hidden = device->hidden;
+    struct AHIRequest *req = &hidden->req[hidden->current_buffer];
+
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    if (req->ahir_Std.io_Data) {
+        WaitIO((struct IORequest *)req);
+        req->ahir_Std.io_Data = NULL;
+        GetMsg(&hidden->ahiport);
+    }
+    return true;
+}
+
+static bool AHI_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    AHIAudioData *hidden = device->hidden;
+    struct AHIRequest *req;
+    ULONG current, current2;
+
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    current = hidden->current_buffer;
+    current2 = current ^ 1;
+    req = &hidden->req[current];
+
+    req->ahir_Std.io_Data   = (APTR)buffer;
+    req->ahir_Std.io_Length = buflen;
+    req->ahir_Std.io_Offset = 0;
+    req->ahir_Frequency     = device->spec.freq;
+    req->ahir_Volume        = AHI_Volume;
+    req->ahir_Type          = hidden->sample_format;
+    req->ahir_Position      = 0x8000;
+    req->ahir_Link          = (hidden->playing ? &hidden->req[current2] : NULL);
+
+    hidden->current_buffer = current2;
+    hidden->playing = 1;
+
+    SendIO((struct IORequest *)req);
+    return true;
+}
+
+static Uint8 *AHI_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    AHIAudioData *hidden = device->hidden;
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+    return (Uint8 *)hidden->buffers[hidden->current_buffer];
+}
+
+static void AHI_CloseDevice(SDL_AudioDevice *device)
+{
+    AHIAudioData *hidden = device->hidden;
+
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    if (!hidden)
+        return;
+
+    if (hidden->buffers[0]) {
+        SDL_free(hidden->buffers[0]);
+        hidden->buffers[0] = NULL;
+    }
+    if (hidden->buffers[1]) {
+        SDL_free(hidden->buffers[1]);
+        hidden->buffers[1] = NULL;
+    }
+
+    CloseDevice((struct IORequest *)&hidden->req[0].ahir_Std);
+    SDL_free(hidden);
+    device->hidden = NULL;
+}
+
+static void AHI_ThreadInit(SDL_AudioDevice *device)
+{
+    AHIAudioData *hidden = device->hidden;
+
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    hidden->ahiport.mp_Node.ln_Pri = 60;
+    hidden->ahiport.mp_Flags = PA_SIGNAL;
+    hidden->ahiport.mp_SigBit = AllocSignal(-1);
+    hidden->ahiport.mp_SigTask = FindTask(NULL);
+
+    NEWLIST(&hidden->ahiport.mp_MsgList);
+
+    memmove(&hidden->req[1], &hidden->req[0], sizeof(hidden->req[1]));
+}
+
+static void AHI_ThreadDeinit(SDL_AudioDevice *device)
+{
+    AHIAudioData *hidden = device->hidden;
+
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    FreeSignal(hidden->ahiport.mp_SigBit);
+}
+
+static bool AHI_OpenDevice(SDL_AudioDevice *device)
+{
+    AHIAudioData *hidden;
+    int sample_format = -1;
+
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    // Force AHI to a native-endian sample format it understands.
+    switch (device->spec.format) {
+#if SDL_BYTEORDER == SDL_BIG_ENDIAN
+    case SDL_AUDIO_F32LE:
+    case SDL_AUDIO_F32BE:
+    case SDL_AUDIO_S32LE:
+        device->spec.format = SDL_AUDIO_S32BE;
+        break;
+    case SDL_AUDIO_S16LE:
+    default:
+        device->spec.format = SDL_AUDIO_S16BE;
+        break;
+#else
+    case SDL_AUDIO_F32LE:
+    case SDL_AUDIO_F32BE:
+    case SDL_AUDIO_S32BE:
+        device->spec.format = SDL_AUDIO_S32LE;
+        break;
+    case SDL_AUDIO_S16BE:
+    default:
+        device->spec.format = SDL_AUDIO_S16LE;
+        break;
+#endif
+    }
+
+    if (device->spec.channels > 2)
+        device->spec.channels = 2;
+
+    switch (device->spec.format) {
+    case SDL_AUDIO_U8:
+    case SDL_AUDIO_S8:
+        sample_format = device->spec.channels == 1 ? AHIST_M8S : AHIST_S8S;
+        break;
+    case SDL_AUDIO_S16LE:
+    case SDL_AUDIO_S16BE:
+        sample_format = device->spec.channels == 1 ? AHIST_M16S : AHIST_S16S;
+        break;
+    case SDL_AUDIO_S32LE:
+    case SDL_AUDIO_S32BE:
+        sample_format = device->spec.channels == 1 ? AHIST_M32S : AHIST_S32S;
+        break;
+    default:
+        return SDL_SetError("Unsupported audio format");
+    }
+
+    D(bug("[SDL3:AHI] %s: AHI sample format is %ld\n", __func__, sample_format));
+
+    // Recompute device->buffer_size / sample_frames for the chosen format.
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    hidden = (AHIAudioData *)SDL_calloc(1, sizeof(AHIAudioData));
+    if (!hidden)
+        return false;
+    device->hidden = hidden;
+
+    hidden->req[0].ahir_Std.io_Message.mn_ReplyPort = &hidden->ahiport;
+    hidden->req[0].ahir_Std.io_Message.mn_Length = sizeof(struct AHIRequest);
+    hidden->req[0].ahir_Std.io_Command = CMD_WRITE;
+    hidden->req[0].ahir_Std.io_Data = NULL;
+    hidden->req[0].ahir_Version = 6;
+
+    hidden->audioBufferSize = device->buffer_size;
+    hidden->buffers[0] = (Uint8 *)SDL_malloc(hidden->audioBufferSize);
+    hidden->buffers[1] = (Uint8 *)SDL_malloc(hidden->audioBufferSize);
+    if (!hidden->buffers[0] || !hidden->buffers[1])
+        return SDL_SetError("No memory for audio buffer");
+
+    SDL_memset(hidden->buffers[0], device->silence_value, hidden->audioBufferSize);
+    SDL_memset(hidden->buffers[1], device->silence_value, hidden->audioBufferSize);
+
+    hidden->current_buffer = 0;
+    hidden->sample_format = sample_format;
+    hidden->playing = 0;
+    hidden->requestSent = false;
+
+    if (OpenDevice(AHINAME, 0, (struct IORequest *)&hidden->req[0].ahir_Std, 0) != 0)
+        return SDL_SetError("Unable to open ahi.device unit 0! Error code %d.", hidden->req[0].ahir_Std.io_Error);
+
+    return true;
+}
+
+static void AHI_FillCaptureRequest(struct AHIRequest *request, void *buffer, int length, int frequency, int type)
+{
+    request->ahir_Std.io_Message.mn_Node.ln_Pri = 60;
+    request->ahir_Std.io_Data    = buffer;
+    request->ahir_Std.io_Length  = length;
+    request->ahir_Std.io_Command = CMD_READ;
+    request->ahir_Volume         = AHI_Volume;
+    request->ahir_Position       = 0x8000;
+    request->ahir_Link           = NULL;
+    request->ahir_Frequency      = frequency;
+    request->ahir_Type           = type;
+}
+
+static int AHI_RecordDevice(SDL_AudioDevice *device, void *buffer, int buflen)
+{
+    struct AHIRequest *request;
+    AHIAudioData *hidden = device->hidden;
+    Uint64 now;
+    UBYTE current;
+    size_t copyLen;
+    void *completedBuffer;
+
+    now = SDL_GetTicks();
+    current = hidden->current_buffer;
+    request = &hidden->req[0];
+
+    if (hidden->lastCaptureTicks == 0 || (now - hidden->lastCaptureTicks) > RESTART_CAPTURE_THRESHOLD) {
+        if (hidden->requestSent)
+            WaitIO((struct IORequest *)request);
+
+        AHI_FillCaptureRequest(request, hidden->buffers[current], hidden->audioBufferSize, device->spec.freq, hidden->sample_format);
+        request->ahir_Std.io_Offset = 0;
+
+        D(bug("[SDL3:AHI] %s: Start recording\n", __func__));
+
+        DoIO((struct IORequest *)request);
+        hidden->requestSent = false;
+        current = 1 - current;
+    } else {
+        if (hidden->requestSent)
+            WaitIO((struct IORequest *)request);
+    }
+
+    AHI_FillCaptureRequest(request, hidden->buffers[current], hidden->audioBufferSize, device->spec.freq, hidden->sample_format);
+    SendIO((struct IORequest *)request);
+    hidden->requestSent = true;
+
+    current = 1 - current;
+    completedBuffer = hidden->buffers[current];
+
+    copyLen = MIN((size_t)buflen, (size_t)hidden->audioBufferSize);
+    SDL_memcpy(buffer, completedBuffer, copyLen);
+
+    hidden->lastCaptureTicks = now;
+    hidden->current_buffer = current;
+
+    return (int)copyLen;
+}
+
+static bool AHI_Init(SDL_AudioDriverImpl *impl)
+{
+    D(bug("[SDL3:AHI] %s()\n", __func__));
+
+    impl->DetectDevices = AHI_DetectDevices;
+    impl->OpenDevice = AHI_OpenDevice;
+    impl->ThreadInit = AHI_ThreadInit;
+    impl->ThreadDeinit = AHI_ThreadDeinit;
+    impl->PlayDevice = AHI_PlayDevice;
+    impl->WaitDevice = AHI_WaitDevice;
+    impl->GetDeviceBuf = AHI_GetDeviceBuf;
+    impl->RecordDevice = AHI_RecordDevice;
+    impl->CloseDevice = AHI_CloseDevice;
+    impl->FreeDeviceHandle = AHI_FreeHandle;
+
+    impl->ProvidesOwnCallbackThread = false;
+    impl->HasRecordingSupport = true;
+
+    return true;
+}
+
+AudioBootStrap AHIAUD_bootstrap = {
+    "ahi", "AHI audio driver", AHI_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_AHI
