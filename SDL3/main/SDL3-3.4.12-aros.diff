+
+void
+AROS_MaximizeWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	SDL_VideoData *vd = (SDL_VideoData *) data->videodata;
+
+	D(bug("[SDL3:aroswindow] %s: wnd 0x%08lx - w=%d, h=%d\n", __func__, data->win, data->win->MaxWidth, data->win->MaxHeight));
+	
+	if (data->win && window->flags & SDL_WINDOW_RESIZABLE) {
+		
+		data->sdlflags |=  SDL_WINDOW_MAXIMIZED;
+		data->sdlflags &= ~SDL_WINDOW_MINIMIZED;
+		
+		ChangeWindowBox(data->win, 0, (vd->CustomScreen == NULL ? data->win->WScreen->BarHeight + 1 : 0), data->win->MaxWidth, data->win->MaxHeight);
+	}
+}
+
+void
+AROS_MinimizeWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+
+	D(bug("[SDL3:aroswindow] %s: wnd 0x%08lx\n", __func__, data->win));
+
+	data->sdlflags |=  SDL_WINDOW_MINIMIZED;
+	data->sdlflags &= ~SDL_WINDOW_MAXIMIZED;
+
+	AROS_HideWindow(_this, window);
+}
+
+void
+AROS_RestoreWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+
+	D(bug("[SDL3:aroswindow] %s: wnd 0x%08lx\n", __func__, data->win));
+
+	if (data->win) {
+		data->sdlflags &= ~(SDL_WINDOW_MINIMIZED | SDL_WINDOW_MAXIMIZED);
+
+		ChangeWindowBox(data->win, window->x, window->y, window->w, window->h);
+		AROS_WindowToFront(data->win);
+	}
+}
+
+SDL_FullscreenResult
+AROS_SetWindowFullscreen(SDL_VideoDevice *_this, SDL_Window * window, SDL_VideoDisplay * _display, SDL_FullscreenOp fullscreen)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	SDL_VideoData *vd = data->videodata;
+
+	if (fullscreen) {
+		data->winflags |= SDL_AROS_WINDOW_FULLSCREEN;
+		if ((window->flags & SDL_WINDOW_FULLSCREEN) == SDL_WINDOW_FULLSCREEN) {
+			data->winflags |= SDL_AROS_WINDOW_FULLSCREEN_DESKTOP;
+		}	
+		int ww, hh;
+		SDL_GetWindowSize(window, &ww, &hh);
+		
+		data->old_x = data->curr_x;
+		data->old_y = data->curr_y;
+		data->old_w = ww;
+		data->old_h = hh;
+
+		D(bug("[SDL3:aroswindow] %s: Save actual position %d,%d and size %d,%d\n", __func__, data->old_x, data->old_y, data->old_w, data->old_h));
+		
+	} else {
+		
+		data->winflags &= ~SDL_AROS_WINDOW_FULLSCREEN;
+
+		if ((data->old_w && data->old_h) && (data->old_w != data->curr_w && data->old_h != data->curr_h)) {
+			D(bug("[SDL3:aroswindow] %s: Change position %d,%d and size %d,%d\n", __func__, data->old_x, data->old_y, data->old_w, data->old_h));
+			window->x = data->old_x;
+			window->y = data->old_y;
+			window->w = data->old_w;
+			window->h = data->old_h;
+			data->old_w = 0;
+			data->old_h = 0;
+			data->old_x = 0;
+			data->old_y = 0;		
+		}
+
+	}
+	vd->FullScreen = fullscreen;
+
+	AROS_OpenWindows(_this);
+
+	return SDL_FULLSCREEN_SUCCEEDED;
+}
+
+bool
+AROS_SetWindowGrab(SDL_VideoDevice *_this, SDL_Window * window, bool grabbed)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+
+	if (data->win && data->grabbed != (grabbed ? 1 : 0)) {
+		D(bug("[SDL3:aroswindow] %s: %s\n", __func__, grabbed ? "grabbed" : "not grabbed"));
+
+		data->grabbed = grabbed ? 1 : 0;
+
+		if (grabbed && (data->win->Flags & WFLG_WINDOWACTIVE) == 0)
+			AROS_WindowToFront(data->win);
+#if !defined(__AROS__)
+		DoMethod((Object *)data->win, grabbed ? WM_ObtainEvents : WM_ReleaseEvents);
+#endif
+	}
+
+	return true;
+}
+
+void
+AROS_DestroyWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	
+	window->internal = NULL;
+
+	if (data) {
+		SDL_VideoData *videodata = (SDL_VideoData *) data->videodata;
+
+		REMOVE(&data->node);
+
+		if (data->win) {
+			AROS_CloseWindowSafely(window, data->win);
+			data->win = NULL;
+		}
+		if (data->region)
+			DisposeRegion(data->region);
+
+		if (IsListEmpty((struct List *)&videodata->windowlist)) {
+			D(bug("[SDL3:aroswindow] %s: Was last window... get rid of screen.\n", __func__));
+			AROS_CloseDisplay(_this);
+		}
+
+		SDL_free(data->window_title);
+		SDL_free(data);
+	}
+}
+
+static void 
+AROS_CloseWindow(SDL_Window *window)
+{
+    SDL_WindowData *data = (SDL_WindowData *)window->internal;
+	D(bug("[SDL3:aroswindow] %s: 0x%08lx\n", __func__, data->win));
+
+    if (data->win) {
+        if (data->appmsg) {
+            if (RemoveAppWindow(data->appmsg)) {
+                data->appmsg = NULL;
+            }
+        }
+
+
+		struct Window *win = data->win;
+
+#if defined(__AROS__)
+		win->UserPort = NULL;
+		ModifyIDCMP(win, 0);
+#endif
+
+        if (data->menuactive == TRUE) {
+            ClearMenuStrip(win);
+            FreeMenus(data->menu);
+            data->menu = NULL;
+            FreeVisualInfo(data->menuvisualinfo);
+            data->menuvisualinfo = NULL;
+            data->menuactive = FALSE;
+        }
+        CloseWindow(win);
+        data->win = NULL;
+    }
+}
+
+void 
+AROS_RecreateWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	D(bug("[SDL3:aroswindow] %s: 0x%08lx\n", __func__, data->win));
+	
+    if (window->flags & SDL_WINDOW_EXTERNAL) {
+		D(bug("[SDL3:aroswindow] %s: Cannot modify native window '%s'\n", __func__, window->title));
+        return;
+    }
+
+    if (data->win) {
+		D(bug("[SDL3:aroswindow] %s: Closing system window '%s' before re-creation\n", __func__, window->title));
+        AROS_CloseWindow(window);
+    }
+
+    AROS_ShowWindow_Internal(_this, window);
+
+    if (data->win) { // Make sure the new window is active
+        AROS_ShowWindow(_this, window);
+    }
+}
+
+void
+AROS_SetWindowAlwaysOnTop(SDL_VideoDevice *_this, SDL_Window * window, bool on_top)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+	AROS_RecreateWindow(_this, window);
+}
+
+/* int
+AROS_SetWindowHitTest(SDL_Window *window, bool enabled)
+{
+    return 0;
+}*/
+
+void
+AROS_SetWindowResizable(SDL_VideoDevice *_this, SDL_Window * window, bool resizable)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+	AROS_RecreateWindow(_this, window);
+}
+
+void
+AROS_SetWindowBordered(SDL_VideoDevice *_this, SDL_Window * window, bool bordered)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+	AROS_RecreateWindow(_this, window);
+}
+
+static bool
+AROS_SetWindowOpacityPrivate(SDL_VideoDevice *_this, SDL_Window * window, ULONG value)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	
+	LONG ret = 0;
+#if !defined(__AROS__)
+	ret = SetAttrs(data->win, WA_Opacity, value, TAG_DONE);
+#endif
+	if (ret) {
+		D(bug("[SDL3:aroswindow] %s: Failed to set window opaqueness to %lu\n", __func__, value));
+		return false;
+	}
+
+	return true;
+}
+
+bool
+AROS_SetWindowOpacity(SDL_VideoDevice *_this, SDL_Window * window, float opacity)
+{
+    SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	if (!data->win) 
+		return true;
+	
+    ULONG value = ((opacity) * (ULONG_MAX));
+
+	D(bug("[SDL3:aroswindow] %s: set window opaqueness to %lu\n", __func__, value));
+	bool ret = true;
+#if !defined(__AROS__)
+	ret = AROS_SetWindowOpacityPrivate(_this, window, value);
+#endif
+    return ret;
+}
+
+static void
+AROS_FlashOperationPrivate(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+    if (data->win) {
+
+		ULONG value_old = 0;
+#if !defined(__AROS__)
+		value_old = getv(data->win, WA_Opacity);
+#endif
+		WindowToFront(data->win);
+		const Uint32 start = SDL_GetTicks();
+		ULONG elapsed = 0;
+		ULONG value = 0;
+		
+		while (TRUE) {
+			elapsed = SDL_GetTicks() - start;
+			if (elapsed > 200) break;
+			value = 128 + 127 * sinf(elapsed * 3.14159f / 50.0f) * (ULONG_MAX);
+			AROS_SetWindowOpacityPrivate(_this, window, value);	
+			SDL_Delay(1);
+		}
+		
+		ActivateWindow(data->win);
+		AROS_SetWindowOpacityPrivate(_this, window, value_old);
+	}
+}
+
+bool
+AROS_FlashWindow(SDL_VideoDevice *_this, SDL_Window * window, SDL_FlashOperation operation)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	if (!data->win) 
+		return true;
+	
+	switch(operation)
+	{
+		case SDL_FLASH_BRIEFLY:
+		case SDL_FLASH_UNTIL_FOCUSED:
+			AROS_FlashOperationPrivate(_this, window);
+			break;
+		case SDL_FLASH_CANCEL:
+			break;
+	}
+	
+	return true;
+}
+
+bool
+AROS_GetWindowBordersSize(SDL_VideoDevice *_this, SDL_Window * window, int *top, int *left, int *bottom, int *right)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+	
+	if (top)
+		*top = data->win->BorderTop;
+	
+	if (left)
+		*left = data->win->BorderLeft;
+	
+	if (bottom)
+		*bottom = data->win->BorderBottom;
+	
+	if (right)
+		*right = data->win->BorderRight;	
+	
+	return true;
+}
