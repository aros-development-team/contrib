+#include "SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_AROS
+
+#include "../SDL_sysjoystick.h"
+
+#include <aros/debug.h>
+
+#include "SDL_sysjoystick_c.h"
+#include "../SDL_joystick_c.h"
+
+#include <exec/execbase.h>
+#include <libraries/lowlevel.h>
+#ifndef NO_LOWLEVEL_EXT
+#include <libraries/lowlevel_ext.h>
+#endif
+#include <proto/exec.h>
+#include <proto/lowlevel.h>
+
+#define SDL_AROS_VENDORID   0xFFFF
+#define SDL_AROS_PRODUCTID  0x0001
+
+static int joystick_count = 0;
+struct Library *LowLevelBase = NULL;
+
+struct SDL_AROS_GAMEINPUT
+{
+    char *gi_name;
+    SDL_GUID gi_guid;
+};
+
+static struct SDL_AROS_GAMEINPUT *aros_gameinput_devices = NULL;
+
+static const unsigned long joybut[] =
+{
+    JPF_BUTTON_RED,
+    JPF_BUTTON_BLUE,
+    JPF_BUTTON_YELLOW,
+    JPF_BUTTON_GREEN,
+    JPF_BUTTON_PLAY,
+    JPF_BUTTON_FORWARD,
+    JPF_BUTTON_REVERSE
+};
+
+/* lowlevel portNumber 0 <-> 1 */
+static int LowLevel_PortFromIndex(int index)
+{
+    switch (index) {
+    case 0:
+        return 1;
+    case 1:
+        return 0;
+    default:
+        break;
+    }
+
+    return index;
+}
+
+static bool AROS_JoystickInit(void)
+{
+    D(bug("[SDL3:Joystick] %s()\n", __func__));
+
+    LowLevelBase = OpenLibrary("lowlevel.library", 37);
+    if (LowLevelBase) {
+        ULONG joyflag = 0L;
+        joystick_count = 0;
+
+        D(bug("[SDL3:Joystick] %s: lowlevel.library @ 0x%p\n", __func__, LowLevelBase));
+
+        aros_gameinput_devices = AllocVec(MAX_JOYSTICKS * sizeof(struct SDL_AROS_GAMEINPUT), MEMF_CLEAR);
+        if (!aros_gameinput_devices) {
+            CloseLibrary(LowLevelBase);
+            LowLevelBase = NULL;
+            return SDL_OutOfMemory();
+        }
+
+        D(bug("[SDL3:Joystick] %s: allocated SDL_AROS_GAMEINPUT @ 0x%p (for %d units)\n", __func__, aros_gameinput_devices, MAX_JOYSTICKS));
+        while (joystick_count < MAX_JOYSTICKS) {
+            int port = LowLevel_PortFromIndex(joystick_count);
+            char *dev_name = NULL;
+            SDL_GUID guid;
+
+            SDL_zero(guid);
+            joyflag = ReadJoyPort(port);
+            if ((joyflag & JP_TYPE_MASK) == JP_TYPE_NOTAVAIL) {
+                break;
+            }
+
+            if ((joyflag & JP_TYPE_MASK) == JP_TYPE_GAMECTLR) {
+                dev_name = AllocVec(26, MEMF_ANY);
+                if (dev_name) {
+                    SDL_snprintf(dev_name, 26, "Game Controller @ Port %d", port);
+                }
+                guid = SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_VIRTUAL,
+                                              SDL_AROS_VENDORID,
+                                              SDL_AROS_PRODUCTID,
+                                              0x0001,
+                                              "AROS",
+                                              "Game Controller",
+                                              0,
+                                              0);
+            }
+
+            if ((joyflag & JP_TYPE_MASK) == JP_TYPE_MOUSE) {
+                dev_name = AllocVec(16, MEMF_ANY);
+                if (dev_name) {
+                    SDL_snprintf(dev_name, 16, "Mouse @ Port %d", port);
+                    guid = SDL_CreateJoystickGUIDForName(dev_name);
+                }
+            }
+
+            if ((joyflag & JP_TYPE_MASK) == JP_TYPE_JOYSTK) {
+                dev_name = AllocVec(19, MEMF_ANY);
+                if (dev_name) {
+                    SDL_snprintf(dev_name, 19, "Joystick @ Port %d", port);
+                    guid = SDL_CreateJoystickGUIDForName(dev_name);
+                }
+            }
+
+            if ((joyflag & JP_TYPE_MASK) == JP_TYPE_UNKNOWN) {
+                dev_name = AllocVec(25, MEMF_ANY);
+                if (dev_name) {
+                    SDL_snprintf(dev_name, 25, "unknown device @ Port %d", port);
+                    guid = SDL_CreateJoystickGUIDForName(dev_name);
+                }
+            }
+
+            if (!dev_name) {
+                break;
+            }
+
+            D(bug("[SDL3:Joystick] %s: #%d '%s'\n", __func__, joystick_count, dev_name));
+            aros_gameinput_devices[port].gi_name = dev_name;
+            aros_gameinput_devices[port].gi_guid = guid;
+            joystick_count++;
+            SDL_PrivateJoystickAdded(joystick_count); /* instance IDs are device_index + 1 */
+        }
+        return true;
+    }
+
+    SDL_SetError("Unable to open lowlevel.library");
+    return false;
+}
