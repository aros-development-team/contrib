+static void
+AROS_CheckScreenEvent(SDL_VideoDevice *_this)
+{
+	SDL_VideoData *data = (SDL_VideoData *) _this->internal;
+
+#if !defined(__AROS__)
+	for (;;) {
+		struct ScreenNotifyMessage *snm;
+
+		while ((snm = (struct ScreenNotifyMessage *)GetMsg(&data->ScreenNotifyPort)) != NULL) {
+			D(bug("[SDL3:arosevt] %s: check ScreenNotifyMessage\n", __func__));
+
+			switch ((size_t)snm->snm_Value) {
+				case FALSE:
+					AROS_HideApp(_this, FALSE);
+					break;
+
+				case TRUE:
+					AROS_ShowApp(_this);
+					break;
+			}
+		}
+
+		if (data->WScreen)
+			break;
+
+		WaitPort(&data->ScreenNotifyPort);
+	}
+#endif
+}
