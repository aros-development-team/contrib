+++ SDL3-3.4.12.aros/src/video/aros/SDL_arosclipboard.c	2026-07-28 13:08:21.792152599 +0100
@@ -0,0 +1,277 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
