+static void 
+AROS_CloseWindowSafely(SDL_Window *sdlwin, struct Window *win)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+	if (SDL_GetKeyboardFocus() == sdlwin)
+		SDL_SetKeyboardFocus(NULL);
+
+	if (SDL_GetMouseFocus() == sdlwin)
+		SDL_SetMouseFocus(NULL);
+		
+    if ((sdlwin->flags & SDL_WINDOW_EXTERNAL) == 0) {
+        struct IntuiMessage *msg, *tmp;
+
+        Forbid();
+
+        ForeachNodeSafe(&win->UserPort->mp_MsgList, msg, tmp)
+        {
+            if (msg->IDCMPWindow == win) {
+                REMOVE(&msg->ExecMessage.mn_Node);
+                ReplyMsg(&msg->ExecMessage);
+            }
+        }
+
+		win->UserPort = NULL;
+		ModifyIDCMP(win, 0);
+
+		SDL_WindowData *data = (SDL_WindowData *) sdlwin->internal;
+		if (data->menuactive == TRUE) {
+            ClearMenuStrip(win);
+            FreeMenus(data->menu);
+            data->menu = NULL;
+            FreeVisualInfo(data->menuvisualinfo);
+            data->menuvisualinfo = NULL;
+            data->menuactive = FALSE;
+        }
+
+        CloseWindow(win);
+
+        Permit();
+    }
+}
+
+void 
+AROS_CloseWindows(SDL_VideoDevice *_this)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+    SDL_VideoData *data = (SDL_VideoData *)_this->internal;
+    SDL_WindowData *wd;
+
+    ForeachNode(&data->windowlist, wd)
+    {
+        struct Window *win = wd->win;
+
+        if (win) {
+            wd->win = NULL;
+            AROS_CloseWindowSafely(wd->window, win);
+        }
+    }
+}
+
+void 
+AROS_OpenWindows(SDL_VideoDevice *_this)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+
+    SDL_VideoData *data = (SDL_VideoData *)_this->internal;
+    SDL_WindowData *wd;
+
+    ForeachNode(&data->windowlist, wd)
+    {
+        if (!(wd->window->flags & SDL_WINDOW_EXTERNAL) && (wd->winflags & SDL_AROS_WINDOW_SHOWN)) {
+            if (wd->win == NULL) {
+                AROS_ShowWindow_Internal(_this, wd->window);
+            } else {
+                if ((wd->window->flags & SDL_WINDOW_FULLSCREEN) == SDL_WINDOW_FULLSCREEN) {
+                    AROS_RecreateWindow(_this, wd->window);
+                } else if (wd->winflags & SDL_AROS_WINDOW_FULLSCREEN_DESKTOP) {
+                    wd->winflags &= ~SDL_AROS_WINDOW_FULLSCREEN_DESKTOP;
+                    wd->window->flags &= ~SDL_WINDOW_FULLSCREEN;
+                    AROS_RecreateWindow(_this, wd->window);
+                }
+            }
+        }
+    }
+}
+
+static bool
+AROS_SetupWindowData(SDL_VideoDevice *_this, SDL_Window *window, struct Window *win)
+{
+	D(bug("[SDL3:aroswindow] %s()\n", __func__));
+	
+	SDL_VideoData *data = (SDL_VideoData *) _this->internal;
+	SDL_WindowData *wd = SDL_calloc(1, sizeof(*wd));
+	
+	if (wd) {
+		window->internal = wd;
+		ADDHEAD(&data->windowlist, wd);
+		wd->bitmap = NULL;
+		wd->region = NULL;
+		wd->fb = NULL;
+		wd->window = window;
+		wd->win = win;
+		wd->grabbed = -1;
+		wd->sdlflags = 0;
+		wd->window_title = NULL;
+		wd->videodata = data;
+		wd->first_deltamove = 0;
+		wd->winflags = 0;
+		wd->appmsg = NULL;
+		wd->menu = NULL;     
+	    wd->menuvisualinfo = NULL;
+        wd->menuactive = FALSE;
+		if (win)
+			win->UserData = (APTR)wd;
+		else {
+			wd->old_w = 0;
+			wd->old_h = 0;
+			wd->old_x = 0;
+			wd->old_y = 0;
+		}
+	} else {
+		return SDL_OutOfMemory();
+	}
+	return true;
+}
+
+bool
+AROS_CreateWindow(SDL_VideoDevice *_this, SDL_Window * window, SDL_PropertiesID create_props)
+{
+	return AROS_SetupWindowData(_this, window, NULL);
+}
