+*/
+
+#define __NOLIBBASE__
+
+#include "SDL_internal.h"
+
+#ifdef SDL_FSOPS_AROS
+
+#include "../SDL_sysfilesystem.h"
+
+#include <dos/dos.h>
+#include <proto/dos.h>
+
+extern struct DosLibrary *DOSBase;
+
+/* AROS DateStamps count from 1978-01-01; the Unix epoch (1970-01-01) is
+   2922 days earlier. SDL_Time is nanoseconds since the Unix epoch. */
+#define AROS_UNIX_EPOCH_DAYS 2922
+
+static SDL_Time AROS_DateStampToTime(const struct DateStamp *ds)
+{
+    Sint64 secs = ((Sint64)(ds->ds_Days + AROS_UNIX_EPOCH_DAYS)) * 86400
+                + (Sint64)ds->ds_Minute * 60
+                + (Sint64)ds->ds_Tick / TICKS_PER_SECOND;
+
+    return (SDL_Time)(secs * SDL_NS_PER_SECOND
+        + ((Sint64)(ds->ds_Tick % TICKS_PER_SECOND)) * (SDL_NS_PER_SECOND / TICKS_PER_SECOND));
+}
+
+bool SDL_SYS_EnumerateDirectory(const char *path, SDL_EnumerateDirectoryCallback cb, void *userdata)
+{
+    BPTR lock;
+    struct FileInfoBlock *fib;
+    SDL_EnumerationResult result = SDL_ENUM_CONTINUE;
+
+    lock = Lock((STRPTR)path, SHARED_LOCK);
+    if (!lock) {
+        return SDL_SetError("Can't open directory '%s'", path);
+    }
+
+    fib = (struct FileInfoBlock *)AllocDosObject(DOS_FIB, NULL);
+    if (!fib) {
+        UnLock(lock);
+        return SDL_OutOfMemory();
+    }
+
+    if (Examine(lock, fib)) {
+        /* ExNext() returns only the directory contents (no "." or ".."). */
+        while ((result == SDL_ENUM_CONTINUE) && ExNext(lock, fib)) {
+            result = cb(userdata, path, fib->fib_FileName);
+        }
+    }
+
+    FreeDosObject(DOS_FIB, fib);
+    UnLock(lock);
+
+    return (result != SDL_ENUM_FAILURE);
+}
+
+bool SDL_SYS_RemovePath(const char *path)
+{
+    if (DeleteFile((STRPTR)path)) {
+        return true;
+    }
+
+    /* Matching the POSIX backend: a path that is already gone is a success. */
+    if (IoErr() == ERROR_OBJECT_NOT_FOUND) {
+        return true;
+    }
+
+    return SDL_SetError("Couldn't remove '%s'", path);
+}
+
+bool SDL_SYS_RenamePath(const char *oldpath, const char *newpath)
+{
+    if (Rename((STRPTR)oldpath, (STRPTR)newpath)) {
+        return true;
+    }
+
+    /* AROS Rename() will not overwrite an existing target; emulate the POSIX
+       rename() semantics by removing the target first and retrying. */
+    if (IoErr() == ERROR_OBJECT_EXISTS) {
+        if (DeleteFile((STRPTR)newpath) && Rename((STRPTR)oldpath, (STRPTR)newpath)) {
+            return true;
+        }
+    }
+
+    return SDL_SetError("Couldn't rename '%s' to '%s'", oldpath, newpath);
+}
+
+bool SDL_SYS_CopyFile(const char *oldpath, const char *newpath)
+{
+    BPTR in, out;
+    bool result = true;
+    LONG n;
+    char *buffer;
+    const int buflen = 16384;
+
+    in = Open((STRPTR)oldpath, MODE_OLDFILE);
+    if (!in) {
+        return SDL_SetError("Couldn't open '%s' for reading", oldpath);
+    }
+
+    out = Open((STRPTR)newpath, MODE_NEWFILE);
+    if (!out) {
+        Close(in);
+        return SDL_SetError("Couldn't open '%s' for writing", newpath);
+    }
+
+    buffer = (char *)SDL_malloc(buflen);
+    if (!buffer) {
+        Close(out);
+        Close(in);
+        return SDL_OutOfMemory();
+    }
+
+    while ((n = Read(in, buffer, buflen)) > 0) {
+        if (Write(out, buffer, n) != n) {
+            result = SDL_SetError("Write to '%s' failed", newpath);
+            break;
+        }
+    }
+
+    if (n < 0) {
+        result = SDL_SetError("Read from '%s' failed", oldpath);
+    }
+
+    SDL_free(buffer);
+    Close(out);
+    Close(in);
+
+    return result;
+}
+
+bool SDL_SYS_CreateDirectory(const char *path)
+{
+    BPTR lock = CreateDir((STRPTR)path);
+
+    if (lock) {
+        UnLock(lock);
+        return true;
+    }
+
+    /* An already-existing directory is treated as success. */
+    if (IoErr() == ERROR_OBJECT_EXISTS) {
+        return true;
+    }
+
+    return SDL_SetError("Couldn't create directory '%s'", path);
+}
+
+bool SDL_SYS_GetPathInfo(const char *path, SDL_PathInfo *info)
+{
+    BPTR lock;
+    struct FileInfoBlock *fib;
+    bool result = false;
+
+    lock = Lock((STRPTR)path, SHARED_LOCK);
+    if (!lock) {
+        return SDL_SetError("Can't stat '%s'", path);
+    }
+
+    fib = (struct FileInfoBlock *)AllocDosObject(DOS_FIB, NULL);
+    if (!fib) {
+        UnLock(lock);
+        return SDL_OutOfMemory();
+    }
+
+    if (Examine(lock, fib)) {
+        if (fib->fib_DirEntryType > 0) {
+            info->type = SDL_PATHTYPE_DIRECTORY;
+            info->size = 0;
+        } else {
+            info->type = SDL_PATHTYPE_FILE;
+            info->size = (Uint64)fib->fib_Size;
+        }
+        info->create_time = 0;
+        info->modify_time = AROS_DateStampToTime(&fib->fib_Date);
+        info->access_time = info->modify_time;
+        result = true;
+    } else {
+        SDL_SetError("Can't examine '%s'", path);
+    }
+
+    FreeDosObject(DOS_FIB, fib);
+    UnLock(lock);
+
+    return result;
+}
+
+#endif /* SDL_FSOPS_AROS */
diff -ruN --strip-trailing-cr SDL3-3.4.12/src/joystick/aros/SDL_sysjoystick.c SDL3-3.4.12.aros/src/joystick/aros/SDL_sysjoystick.c
