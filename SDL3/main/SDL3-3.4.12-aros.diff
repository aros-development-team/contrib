+++ SDL3-3.4.12.aros/src/thread/aros/SDL_syssem.c	2026-07-28 13:08:21.783632797 +0100
@@ -0,0 +1,192 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
