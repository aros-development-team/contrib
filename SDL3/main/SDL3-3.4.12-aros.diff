+*/
+
+//#define DEBUG 1
+#include <aros/debug.h>
+
+#include "SDL_internal.h"
+
+// Thread management routines for SDL3
+
+#include "../SDL_systhread.h"
+#include "../SDL_thread_c.h"
+
+#include <exec/execbase.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+
+static const char *warn_NoResources = "Not enough resources to create thread";
+
+static AROS_UFH3(Uint32, RunThread,
+    AROS_UFHA(char *,              args, A0),
+    AROS_UFHA(ULONG,               argSize, D0),
+    AROS_UFHA(struct ExecBase *,   SysBase, A6))
+{
+    AROS_USERFUNC_INIT
+
+    struct Task *thisTask = FindTask(NULL);
+    SDL_Thread *thread = (SDL_Thread *)thisTask->tc_UserData;
+
+    D(bug("[SDL3:Thread] 0x%p:%s: Entered Thread (0x%p)\n", thisTask, __func__, thread));
+
+    SDL_RunThread(thread);
+
+    D(bug("[SDL3:Thread] 0x%p:%s: Thread returned\n", thisTask, __func__));
+
+    if ((thread->handle.tp_Parent) && (thread->handle.tp_PSig != -1))
+        Signal(thread->handle.tp_Parent, (1 << thread->handle.tp_PSig));
+
+    return 0;
+
+    AROS_USERFUNC_EXIT
+}
+
+bool SDL_SYS_CreateThread(SDL_Thread *thread,
+                          SDL_FunctionPointer pfnBeginThread,
+                          SDL_FunctionPointer pfnEndThread)
+{
+    thread->handle.tp_Parent = FindTask(NULL);
+    thread->handle.tp_PSig   = AllocSignal(-1);
+    if (thread->handle.tp_PSig == -1) {
+        return SDL_SetError("%s", warn_NoResources);
+    }
+
+    D(
+        bug("[SDL3:Thread] %s: Spawning new process\n", __func__);
+        bug("[SDL3:Thread] %s:        parent = 0x%p (thisTask)\n", __func__, thread->handle.tp_Parent);
+        bug("[SDL3:Thread] %s:        psig   = %08x\n", __func__, thread->handle.tp_PSig);
+    )
+
+    // launch it...
+    thread->handle.tp_Task = (struct Task *)CreateNewProcTags(
+        NP_Output,      Output(),
+        NP_StackSize,   (IPTR)(thread->handle.tp_Parent->tc_SPUpper - thread->handle.tp_Parent->tc_SPLower),
+        NP_Entry,       (IPTR)RunThread,
+        NP_UserData,    thread,
+        NP_CloseOutput, FALSE,
+        TAG_DONE);
+
+    if (!thread->handle.tp_Task) {
+        FreeSignal(thread->handle.tp_PSig);
+        thread->handle.tp_PSig = -1;
+        return SDL_SetError("%s", warn_NoResources);
+    }
+
+    return true;
+}
+
+void SDL_SYS_SetupThread(const char *name)
+{
+    struct Task *t = FindTask(NULL);
+    D(bug("[SDL3:Thread] %s('%s')\n", __func__, name));
+    if (name) {
+        t->tc_Node.ln_Name = (STRPTR)name;
+    }
+}
+
+SDL_ThreadID SDL_GetCurrentThreadID(void)
+{
+    return (SDL_ThreadID)(IPTR)FindTask(NULL);
+}
+
+bool SDL_SYS_SetThreadPriority(SDL_ThreadPriority priority)
+{
+    LONG pri;
+
+    switch (priority) {
+    case SDL_THREAD_PRIORITY_LOW:
+        pri = -1;
+        break;
+    case SDL_THREAD_PRIORITY_HIGH:
+        pri = 5;
+        break;
+    case SDL_THREAD_PRIORITY_TIME_CRITICAL:
+        pri = 10;
+        break;
+    default:
+        pri = 0;
+        break;
+    }
+
+    D(bug("[SDL3:Thread] %s: setting priority to %d\n", __func__, pri));
+
+    SetTaskPri(FindTask(NULL), pri);
+    return true;
+}
+
+void SDL_SYS_WaitThread(SDL_Thread *thread)
+{
+    D(bug("[SDL3:Thread] %s()\n", __func__));
+
+    if (thread->handle.tp_PSig != -1) {
+        ULONG sigs = SetSignal(0L, SIGBREAKF_CTRL_F | SIGBREAKF_CTRL_C);
+        ULONG newsigs = Wait(SIGBREAKF_CTRL_F | SIGBREAKF_CTRL_C | (1 << thread->handle.tp_PSig));
+        SetSignal((sigs | newsigs) & ~(1 << thread->handle.tp_PSig), 0);
+        FreeSignal(thread->handle.tp_PSig);
+        thread->handle.tp_PSig = -1;
+    }
+    D(bug("[SDL3:Thread] %s: wait done\n", __func__));
+}
+
+void SDL_SYS_DetachThread(SDL_Thread *thread)
+{
+    D(bug("[SDL3:Thread] %s()\n", __func__));
+}
+
