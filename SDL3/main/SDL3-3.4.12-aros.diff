+static void
+AROS_Joystick(struct Window *window)
+{
+	char text1[2000] = "";
+	char text2[254] = "";
+	int i;
+    int controller_count = 0;
+    char guid[64];
+	
+	SDL_InitSubSystem(SDL_INIT_JOYSTICK | SDL_INIT_GAMEPAD);
+
+	int num_joysticks = 0;
+	SDL_JoystickID *joysticks = SDL_GetJoysticks(&num_joysticks);
+
+	for (i = 0; joysticks && i < num_joysticks; ++i) {
+    	const char *name;
+		char text[254] = "";
+		SDL_JoystickID instance_id = joysticks[i];
+		SDL_GUIDToString(SDL_GetJoystickGUIDForID(instance_id), guid, sizeof (guid));
+		SDL_Joystick *joystick = SDL_OpenJoystick(instance_id);
+        if (joystick != NULL) {		
+			if (SDL_IsGamepad(instance_id)) {
+				controller_count++;
+				name = SDL_GetGamepadNameForID(instance_id);
+			} else {
+				name = SDL_GetJoystickNameForID(instance_id);	
+			}			
+		
+			snprintf(text, sizeof(text), "%d: %s (guid %s, VID 0x%.4x, PID 0x%.4x, player index = %d)\n",
+				i, name ? name : "Unknown", guid,
+			SDL_GetJoystickVendorForID(instance_id), SDL_GetJoystickProductForID(instance_id), SDL_GetJoystickPlayerIndexForID(instance_id));
+			strcat(text1, text);
+			snprintf(text, sizeof(text),"    Joystick has %d axes, %d hats, %d balls, and %d buttons\n",
+			SDL_GetNumJoystickAxes(joystick), SDL_GetNumJoystickHats(joystick),
+			SDL_GetNumJoystickBalls(joystick), SDL_GetNumJoystickButtons(joystick));
+			strcat(text1, text);
+			SDL_CloseJoystick(joystick);
+		}
+	}
+	SDL_free(joysticks);
+	
+	snprintf(text2, sizeof(text2),"There are %d game controller(s) attached (%d joystick(s))\n", controller_count, num_joysticks);
+	struct EasyStruct es;
+	es.es_StructSize   = sizeof(struct EasyStruct);
+	es.es_Flags        = 0;
+	es.es_Title        = "SDL3 Joystick/GameController";
+	es.es_TextFormat   = "SDL %ld.%ld.%ld -AROS-\n\n%s\n%s";
+	es.es_GadgetFormat = "Ok";
+
+	EasyRequest(window, &es, NULL, SDL_MAJOR_VERSION, SDL_MINOR_VERSION, SDL_MICRO_VERSION, (IPTR)text2, (IPTR)text1);
+}
