+		}
+	}
+	D(bug("[SDL3:arosgl] %s: returning 0x%p\n", __func__, func));
+	return (SDL_FunctionPointer)func;
+}
+
+void
+AROS_GL_UnloadLibrary(SDL_VideoDevice *_this)
+{
+	D(bug("[SDL3:arosgl] %s()\n", __func__));
+
+#if (0)
+	if (SDL3Base->appGLABase && *SDL3Base->appGLABase)
+#endif
+	if (GLBase) {
+		D(bug("[SDL3:arosgl] %s: closing glABase @ 0x%p\n", __func__, GLBase));
+		CloseLibrary(GLBase);
+		GLBase = NULL;
+#if (0)
+		*SDL3Base->appGLABase = GLBase;
+#endif
+		_this->gl_config.driver_loaded = 0;
+	}
+}
+
+bool
+AROS_GL_MakeCurrent(SDL_VideoDevice *_this, SDL_Window * window, SDL_GLContext context)
+{
+    D(bug("[SDL3:arosgl] %s(0x%p)\n", __func__, context));
+
+    if (window)
+	{
+		if (_this->gl_data->gldd_GLACtx != context)
+		{
+			struct TagItem tags[2];
+			SDL_WindowData *data = (SDL_WindowData *) window->internal;
+			D(bug("[SDL3:arosgl] %s: attaching ctx to window @ 0x%p\n", __func__, data->win));
+			if ((_this->gl_data->gldd_GLACtx = context) != NULL)
+			{
+				tags[0].ti_Tag = GLA_Window;
+				tags[0].ti_Data = (IPTR)data->win;
+				tags[1].ti_Tag = TAG_DONE;
+				glASetRast(context, tags);
+			}
+		}
+		SDL_WindowData *data = (SDL_WindowData *) window->internal;
+		data->__AGLCtx = context;
+		glAMakeCurrent(context);
+    }
+	return true;
+}
+
+SDL_GLContext
+AROS_GL_CreateContext(SDL_VideoDevice *_this, SDL_Window * window)
+{
+    D(bug("[SDL3:arosgl] %s()\n", __func__));
+
+    struct TagItem ctxAttribs [10];
+	LONG i = 0;
+
+    if ( _this->gl_config.red_size   != 0 &&
+            _this->gl_config.blue_size  != 0 &&
+            _this->gl_config.green_size != 0 ) {
+
+		if(!_this->gl_config.stereo ) {
+			/* Required window pointer  */
+			SDL_WindowData *data = (SDL_WindowData *) window->internal;
+			ctxAttribs[i].ti_Tag = GLA_Window;	ctxAttribs[i++].ti_Data = (IPTR)data->win;
+
+			/* _this->gl_config.double_buffer - skipped, GLA always double-buffer */
+			/* _this->gl_config.multisamplebuffers - currently not supported */
+			/* _this->gl_config.multisamplesample - currently not supported */
+
+			/* no depth buffer ? */
+			if ( _this->gl_config.depth_size == 0 ) 
+			{
+				ctxAttribs[i].ti_Tag = GLA_NoDepth;
+				ctxAttribs[i++].ti_Data = GL_TRUE;
+			}
+			/* no stencil buffer ? */
+			if ( _this->gl_config.stencil_size == 0 )
+			{
+				ctxAttribs[i].ti_Tag = GLA_NoStencil;
+				ctxAttribs[i++].ti_Data = GL_TRUE;
+			}
+			/* no accum buffer ? */
+			if ( _this->gl_config.accum_red_size   == 0 && 
+				_this->gl_config.accum_blue_size  == 0 &&
+				_this->gl_config.accum_green_size == 0 )
+			{
+				ctxAttribs[i].ti_Tag = GLA_NoAccum;
+				ctxAttribs[i++].ti_Data = GL_TRUE;
+			}
+
+			/* done */
+			ctxAttribs[i].ti_Tag = TAG_DONE;
+
+			GLAContext newCtx = glACreateContext(ctxAttribs);
+			if ((newCtx) && (_this->gl_data->gldd_GLACtx == NULL))
+				AROS_GL_MakeCurrent(_this, window, newCtx);
+
+			D(bug("[SDL3:arosgl] %s: new glAContext @ 0x%p\n", __func__, newCtx));
+			return newCtx;
+		}
+		else {
+			SDL_SetError("gl.library does not support stereo buffer");
+		}
+	}
+	else {
+		SDL_SetError("gl.library does not work with indexed color");
+	}
+	return NULL;
+}
+
+bool
+AROS_GL_SetSwapInterval(SDL_VideoDevice *_this, int interval)
+{
+    D(bug("[SDL3:arosgl] %s(%d)\n", __func__, interval));
+
+	switch (interval) {
+		case 0:
+		case 1:
+			_this->gl_data->gldd_Interval = (interval ? TRUE : FALSE);
+			return true;
+		default:
+			return SDL_SetError("Unsupported swap interval");
+	}	
+}
+
+bool
+AROS_GL_GetSwapInterval(SDL_VideoDevice *_this, int *interval)
+{
+    D(bug("[SDL3:arosgl] %s()\n", __func__));
+
+	if (interval)
+		*interval = _this->gl_data->gldd_Interval ? 1 : 0;
+
+	return true;
+}
+
+bool
+AROS_GL_SwapWindow(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+
+    D(bug("[SDL3:arosgl] %s(0x%p)\n", __func__, window));
+
+	if (!data->win || !_this->gl_data->gldd_GLACtx)
+		return true;
+
+	glASwapBuffers(_this->gl_data->gldd_GLACtx);
+
+	return true;
+}
+
+bool
+AROS_GL_DestroyContext(SDL_VideoDevice *_this, SDL_GLContext context)
+{
+    D(bug("[SDL3:arosgl] %s(0x%p)\n", __func__, context));
+
+	if ((GLBase) && (context)) {
+		if (_this->gl_data->gldd_GLACtx == context)
+			_this->gl_data->gldd_GLACtx = NULL;
+		glADestroyContext(context);
+	}
+
+	return true;
+}
+
+#endif /* SDL_VIDEO_OPENGL_AGL */
