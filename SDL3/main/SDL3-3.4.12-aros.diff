+    AROS_JoystickGetDevicePlayerIndex,
+    AROS_JoystickSetDevicePlayerIndex,
+    AROS_JoystickGetDeviceGUID,
+    AROS_JoystickGetDeviceInstanceID,
+    AROS_JoystickOpen,
+    AROS_JoystickRumble,
+    AROS_JoystickRumbleTriggers,
+    AROS_JoystickSetLED,
+    AROS_JoystickSendEffect,
+    AROS_JoystickSetSensorsEnabled,
+    AROS_JoystickUpdate,
+    AROS_JoystickClose,
+    AROS_JoystickQuit,
+    AROS_JoystickGetGamepadMapping
+};
+
