+static void
+AROS_ShapeToRegion(struct Region *region, SDL_Surface *shape)
+{
+	D(bug("[SDL3:arosshape] %s()\n", __func__));
+
+	const SDL_PixelFormatDetails *details = SDL_GetPixelFormatDetails(shape->format);
+	const SDL_Palette *palette = SDL_GetSurfacePalette(shape);
+	Uint32 y, bpr, pitch;
+	const Uint8 *pixels;
+
+	if (!details)
+		return;
+
+	bpr = details->bytes_per_pixel;
+
+	if (SDL_MUSTLOCK(shape))
+		SDL_LockSurface(shape);
+
+	pixels = shape->pixels;
+	pitch = shape->pitch;
+
+	for (y = 0; y < (Uint32)shape->h; y++) {
+		struct Rectangle rect;
+		int x, have_transp = 0;
+
+		for (x = 0; x < shape->w; x++) {
+			Uint32 pixel_value = 0, mask_value = 0;
+			Uint8 *pixel = (Uint8 *)(pixels) + (y * pitch) + (x * bpr);
+			Uint8 r, g, b, alpha;
+
+			switch (bpr) {
+				case 1:
+					pixel_value = *(Uint8*)pixel;
+					break;
+
+				case 2:
+					pixel_value = *(Uint16*)pixel;
+					break;
+
+				case 3:
+					pixel_value = *(Uint32*)pixel & (~details->Amask);
+					break;
+
+				case 4:
+					pixel_value = *(Uint32*)pixel;
+					break;
+			}
+
+			SDL_GetRGBA(pixel_value, details, palette, &r, &g, &b, &alpha);
+
+			mask_value = (alpha >= 1 ? 1 : 0);
+
+			if (have_transp == 0) {
+				if (mask_value == 0) {
+					rect.MinX = x;
+					rect.MinY = y;
+					rect.MaxY = y;
+					have_transp = 1;
+				}
+			} else {
+				if (mask_value == 1) {
+					rect.MaxX = x - 1;
+					have_transp = 0;
+					OrRectRegion(region, &rect);
+				}
+			}
+		}
+
+		if (have_transp) {
+			rect.MaxX = shape->w - 1;
+			OrRectRegion(region, &rect);
+		}
+	}
+
+	if (SDL_MUSTLOCK(shape))
+		SDL_UnlockSurface(shape);
+}
+
+bool
+AROS_UpdateWindowShape(SDL_VideoDevice *_this, SDL_Window *window, SDL_Surface *shape)
+{
+	SDL_WindowData *data = (SDL_WindowData *)window->internal;
+	struct Region *old;
+	struct Region *region;
+
+	if (!data)
+		return SDL_SetError("Window has no driver data");
+
+	old = data->region;
+
+	D(bug("[SDL3:arosshape] %s: window: 0x%08lx, internal: 0x%08lx, old: 0x%08lx\n", __func__, window, data, old));
+
+	if (!shape) {
+		data->region = NULL;
+
+		if (old)
+			DisposeRegion(old);
+
+		return true;
+	}
+
+	region = NewRegion();
+
+	if (region) {
+		data->region = region;
+
+		AROS_ShapeToRegion(region, shape);
+
+		if (data->win) {
+#if !defined(__AROS__)
+			size_t tags[] = { TRANSPCONTROL_REGION, (size_t)region, TAG_DONE };
+			D(bug("[SDL3:arosshape] %s:  Set transparency region (0x%08lx)\n", __func__, region));
+			TransparencyControl(data->win, TRANSPCONTROLMETHOD_INSTALLREGION, (struct TagItem *)&tags);
+#endif
+		}
+
+		D(bug("[SDL3:arosshape] %s:  DisposeRegion(0x%08lx)\n", __func__, old));
+
+		if (old)
+			DisposeRegion(old);
+	}
+
+	return true;
+}
