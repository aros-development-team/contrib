+static void AROS_JoystickUpdate(SDL_Joystick *joystick)
+{
+    D(bug("[SDL3:Joystick] %s()\n", __func__));
+    struct joystick_hwdata *hwdata = joystick->hwdata;
+    if (hwdata) {
+        ULONG data;
+#ifndef NO_LOWLEVEL_EXT
+        ULONG data_ext = 0;
+#endif
+        int i;
+        const Uint64 timestamp = SDL_GetTicksNS();
+
+        data = ReadJoyPort(hwdata->port);
+#ifndef NO_LOWLEVEL_EXT
+        if (joystick->hwdata->supports_analog) {
+            data_ext = ReadJoyPort(hwdata->port + JP_ANALOGUE_PORT_MAGIC);
+        }
+#endif
+
+        /* only send an event when something changed */
+
+        /* hats */
+        if ((joystick->hwdata->joystate & JP_DIRECTION_MASK) != (data & JP_DIRECTION_MASK)) {
+            if (joystick->nhats) {
+                Uint8 value_hat = SDL_HAT_CENTERED;
+
+                if (data & JPF_JOY_DOWN) {
+                    value_hat |= SDL_HAT_DOWN;
+                } else if (data & JPF_JOY_UP) {
+                    value_hat |= SDL_HAT_UP;
+                }
+
+                if (data & JPF_JOY_LEFT) {
+                    value_hat |= SDL_HAT_LEFT;
+                } else if (data & JPF_JOY_RIGHT) {
+                    value_hat |= SDL_HAT_RIGHT;
+                }
+
+                SDL_SendJoystickHat(timestamp, joystick, 0, value_hat);
+            }
+        }
+
+        /* axes */
+#ifndef NO_LOWLEVEL_EXT
+        if (joystick->hwdata->supports_analog && data_ext & JP_TYPE_ANALOGUE) {
+            if ((joystick->hwdata->joystate_ext & JP_XAXIS_MASK) != (data_ext & JP_XAXIS_MASK)) {
+                Sint16 value;
+
+                value = (data_ext & JP_XAXIS_MASK) * 2 * 32767 / 255 - 32767;
+                SDL_SendJoystickAxis(timestamp, joystick, 0, value);
+            }
+
+            if ((joystick->hwdata->joystate_ext & JP_YAXIS_MASK) != (data_ext & JP_YAXIS_MASK)) {
+                Sint16 value;
+
+                value = ((data_ext & JP_YAXIS_MASK) >> 8) * 2 * 32767 / 255 - 32767;
+                SDL_SendJoystickAxis(timestamp, joystick, 1, value);
+            }
+        } else
+#endif
+        {
+            if ((joystick->hwdata->joystate & (JPF_JOY_DOWN | JPF_JOY_UP)) != (data & (JPF_JOY_DOWN | JPF_JOY_UP))) {
+                Sint16 value;
+
+                /* UP and DOWN direction */
+                if (data & JPF_JOY_DOWN) {
+                    value = LOWLEVEL_JOY_PLUS;
+                } else if (data & JPF_JOY_UP) {
+                    value = LOWLEVEL_JOY_MINUS;
+                } else {
+                    value = 0;
+                }
+
+                SDL_SendJoystickAxis(timestamp, joystick, 1, value);
+            }
+
+            if ((joystick->hwdata->joystate & (JPF_JOY_LEFT | JPF_JOY_RIGHT)) != (data & (JPF_JOY_LEFT | JPF_JOY_RIGHT))) {
+                Sint16 value;
+
+                /* LEFT and RIGHT direction */
+                if (data & JPF_JOY_LEFT) {
+                    value = LOWLEVEL_JOY_MINUS;
+                } else if (data & JPF_JOY_RIGHT) {
+                    value = LOWLEVEL_JOY_PLUS;
+                } else {
+                    value = 0;
+                }
+
+                SDL_SendJoystickAxis(timestamp, joystick, 0, value);
+            }
+        }
+
+        /* Joy buttons */
+        for (i = 0; i < joystick->nbuttons; i++) {
+            if (data & joybut[i]) {
+                if (i == 1) {
+                    /* FIXME: WTF? */
+                    data &= ~(joybut[2]);
+                }
+
+                if (!(joystick->hwdata->joystate & joybut[i])) {
+                    SDL_SendJoystickButton(timestamp, joystick, i, true);
+                }
+            } else if (joystick->hwdata->joystate & joybut[i]) {
+                SDL_SendJoystickButton(timestamp, joystick, i, false);
+            }
+        }
+
+        joystick->hwdata->joystate = data;
+#ifndef NO_LOWLEVEL_EXT
+        joystick->hwdata->joystate_ext = data_ext;
+#endif
+    }
+}
+
+static void AROS_JoystickClose(SDL_Joystick *joystick)
+{
+    D(bug("[SDL3:Joystick] %s()\n", __func__));
+    struct joystick_hwdata *hwdata = joystick->hwdata;
+    if (hwdata) {
+        SetJoyPortAttrs(hwdata->port, SJA_Type, SJA_TYPE_AUTOSENSE, TAG_END);
+        SDL_free(hwdata);
+        joystick->hwdata = NULL;
+    }
+}
+
+static void AROS_JoystickQuit(void)
+{
+    D(bug("[SDL3:Joystick] %s()\n", __func__));
+    if (aros_gameinput_devices) {
+        int i;
+        for (i = 0; i < joystick_count; i++) {
+            int port = LowLevel_PortFromIndex(i);
+            if (aros_gameinput_devices[port].gi_name) {
+                FreeVec(aros_gameinput_devices[port].gi_name);
+                aros_gameinput_devices[port].gi_name = NULL;
+            }
+        }
+        FreeVec(aros_gameinput_devices);
+        aros_gameinput_devices = NULL;
+    }
+    if (LowLevelBase) {
+        CloseLibrary(LowLevelBase);
+        LowLevelBase = NULL;
+    }
+    joystick_count = 0;
+}
+
+static bool AROS_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    D(bug("[SDL3:Joystick] %s()\n", __func__));
+    return false;
+}
+
+SDL_JoystickDriver SDL_AROS_JoystickDriver =
+{
