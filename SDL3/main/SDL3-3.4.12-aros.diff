+static void
+AROS_CheckBrokerMsg(SDL_VideoDevice *_this)
+{
+	SDL_VideoData *data = (SDL_VideoData *) _this->internal;
+	CxMsg *msg;
+
+	while ((msg = (CxMsg *)GetMsg(&data->BrokerPort))) {
+		size_t id = CxMsgID(msg);
+		size_t tp = CxMsgType(msg);
+
+		D(bug("[SDL3:arosevt] %s: check CxMsg\n", __func__));
+
+		ReplyMsg((APTR)msg);
+
+		if (tp == CXM_COMMAND) {
+			switch (id) {
+				case CXCMD_KILL:
+					SDL_SendAppEvent(SDL_EVENT_QUIT);
+					break;
+
+				case CXCMD_APPEAR:
+					AROS_ShowApp(_this);
+					break;
+
+				case CXCMD_DISAPPEAR:
+					AROS_HideApp(_this, TRUE);
+					break;
+			}
+		}
+	}
+}
