+bool
+AROS_SetWindowPosition(SDL_VideoDevice *_this, SDL_Window * window)
+{
+	SDL_WindowData *data = (SDL_WindowData *) window->internal;
+
+	D(bug("[SDL3:aroswindow] %s: 0x%08lx\n", __func__, data->win));
+
+	if (data->win) {
+		SDL_VideoData *vd = data->videodata;
