+extern struct DosLibrary *DOSBase;
+extern struct Library *UtilityBase;
+
+struct loc
+{
+    const char *name;
+    const char *codeLang;
+};
+
+static const struct loc locs[] =
+{
+    { "dansk",      "da_DK" },
+    { "deutsch",    "de_DE" },
+    { "english",    "en_GB" },
+    { "espanol",    "es_ES" },
+    { "francais",   "fr_FR" },
+    { "greek",      "el_GR" },
+    { "hrvatski",   "hr_HR" },
+    { "italiano",   "it_IT" },
+    { "magyar",     "hu_HU" },
+    { "malti",      "mt_MT" },
+    { "nederlands", "nl_NL" },
+    { "norsk",      "nn_NO" },
+    { "polski",     "pl_PL" },
+    { "portugues",  "pt_PT" },
+    { "russian",    "ru_RU" },
+    { "shqipja",    "sq_AL" },
+    { "suomi",      "fi_FI" },
+    { "svenska",    "sv_SE" },
+    { NULL,         NULL }
+};
+
+bool SDL_SYS_GetPreferredLocales(char *buf, size_t buflen)
+{
+    char language[80];
+
+    language[0] = '\0';
+
+    if (GetVar("LANGUAGE", language, sizeof(language), 0) > 0) {
+        int i;
+        for (i = 0; locs[i].name; i++) {
+            if (Strnicmp((STRPTR)language, (STRPTR)locs[i].name, SDL_strlen(locs[i].name)) == 0) {
+                SDL_strlcpy(buf, locs[i].codeLang, buflen);
+                return true;
+            }
+        }
+    }
+
+    // Fall back to a sensible default rather than reporting failure.
+    SDL_strlcpy(buf, "en_GB", buflen);
+    return true;
+}
